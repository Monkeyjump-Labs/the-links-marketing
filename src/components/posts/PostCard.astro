---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  image?: ImageMetadata;
  imageAlt?: string;
  date: Date;
  title: string;
  description?: string;
}

const { href, image, imageAlt, date, title, description } = Astro.props;
---

<a
  href={href}
  class="text-softBlack no-underline flex flex-col gap-5 outline outline-2 outline-transparent outline-offset-[1.5rem] transition-[outline-color] duration-200 hover:outline-softBlack"
>
  {
    image && (
      <div class="w-full aspect-[12/11] rounded-[5px] overflow-hidden">
        <Image
          class="block w-full h-full object-cover"
          src={image}
          alt={imageAlt ?? title}
          widths={[400, 640, 800, 1100]}
          sizes="(min-width: 75rem) 30rem, (min-width: 56.25rem) 45vw, 100vw"
        />
      </div>
    )
  }
  <time class="font-sans text-base text-softBlack" datetime={date.toISOString()}>
    {date.toISOString().slice(0, 10)}
  </time>
  <h2 class="font-sans text-3xl font-bold leading-none m-0 text-softBlack transition-colors duration-200">
    {title}
  </h2>
  {
    description && (
      <p class="font-sans text-xl font-normal leading-loose text-softBlack m-0 line-clamp-3">{description}</p>
    )
  }
</a>
