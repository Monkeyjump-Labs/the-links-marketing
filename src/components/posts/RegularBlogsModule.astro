---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="max-w-content mx-auto px-6 lg:px-16 py-12 lg:py-20">
      <h2 class="text-base uppercase tracking-widest font-sans font-normal text-softBlack mb-8">All Posts</h2>
      <div class="flex flex-col">
        {posts.map((post) => (
          <article class="border-t-2 border-softBlack py-6 flex flex-col gap-2 lg:flex-row lg:justify-between lg:items-start [&:last-child]:border-b-2">
            <div class="flex-1">
              <h3 class="font-mono text-lg font-normal mb-2">
                <a href={`/blog/${post.slug}/`} class="text-softBlack no-underline hover:text-grape hover:underline">
                  {post.data.title}
                </a>
              </h3>
              <p class="font-sans text-base text-softBlack m-0 opacity-75">{post.data.description}</p>
            </div>
            <div class="flex flex-col items-end font-sans text-sm text-softBlack opacity-60 gap-1 whitespace-nowrap">
              <span>
                {post.data.datePublished.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
              <span>{post.data.author}</span>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}
