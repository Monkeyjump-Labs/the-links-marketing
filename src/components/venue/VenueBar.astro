---
/**
 * The venue bar — a permanent strip under the header.
 *
 * IT HAS EXACTLY TWO JOBS:
 *   1. Tell a visitor there are two locations, roughly where they are, and one
 *      genuinely useful thing about each — today's hours.
 *   2. Take them to that venue's page if they want to know more.
 *
 * IT IS NOT A CONTEXT SWITCHER. An earlier version styled these as tabs, which
 * promised something the component does not do: on 17 of 21 routes NO tab was
 * marked active, and clicking one navigated away rather than filtering the page.
 *
 * Filtering would also fight the site's architecture. Venue is a DIMENSION here,
 * not a fork — /rates is one page with a column per venue, /leagues one page with
 * venue-prefixed rows. A tab that hid one venue's column would quietly re-fork the
 * site and undo the fix for the original problem, which was that Stillwater was
 * invisible. So this reads as a directory, and the "you are here" rule appears
 * only where it is true: on that venue's own page.
 */
import { getVenues, venuePath, orderedHours, formatTime, type Day } from '../../lib/venues';

const venues = await getVenues();
const currentPath = Astro.url.pathname;

const DAY_INDEX: Day[] = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'] as Day[];
const buildDay = DAY_INDEX[new Date().getDay()];

/** Every day, so the client script can relabel to the visitor's real day. */
const hoursFor = (venue: (typeof venues)[number]) =>
  Object.fromEntries(
    orderedHours(venue).map((r) => [r.day, r.closed ? 'Closed' : `${formatTime(r.opens)}–${formatTime(r.closes)}`]),
  );

/** Where it is, for someone who knows the Twin Cities but not the address. */
const AREA: Record<string, string> = {
  lakeville: 'South metro',
  stillwater: 'East metro',
};
---

<div class="on-dark border-t-hairline border-paper/20 bg-midnight" data-venue-bar>
  <nav
    class="mx-auto flex max-w-content flex-wrap items-stretch gap-x-8 px-gutter lg:px-gutter-lg"
    aria-label="Our two venues"
  >
    <span
      class="hidden shrink-0 items-center pr-2 text-label-sm tracking-label-wider text-slate uppercase sm:flex"
      aria-hidden="true"
    >
      Venues
    </span>

    {
      venues.map((venue) => {
        const here = currentPath.startsWith(venuePath(venue));
        const map = hoursFor(venue);
        return (
          <a
            href={venuePath(venue)}
            data-venue-link={venue.data.slug}
            data-hours={JSON.stringify(map)}
            aria-current={here ? 'page' : undefined}
            class:list={[
              'group flex min-h-tap flex-1 items-center gap-x-3 py-2 sm:flex-none',
              // The rule means ONE thing: you are on this venue's page.
              here ? 'border-b-score border-amber' : 'border-b-score border-transparent',
            ]}
          >
            <span class:list={['text-body font-semibold', here ? 'text-white' : 'text-paper']}>
              {venue.data.shortName}
            </span>
            <span class="hidden text-label tracking-label-wide text-slate uppercase md:inline">
              {AREA[venue.data.slug]}
            </span>
            <span class="text-label tracking-label-wide text-slate uppercase" data-venue-hours>
              <span class="sr-only">Hours today, {buildDay}: </span>
              {map[buildDay]}
            </span>
            {here ? (
              <span class="text-label tracking-label-wide text-amber uppercase">You are here</span>
            ) : (
              <span class="text-label text-slate transition group-hover:text-amber" aria-hidden="true">
                →
              </span>
            )}
          </a>
        );
      })
    }
  </nav>
</div>

<script>
  // The server renders the BUILD day. Relabel to the visitor's real day.
  // Enhancement only — the links and the rendered hours are already correct for
  // the day shown, and nothing here changes what page you are on.
  const bar = document.querySelector('[data-venue-bar]');
  if (bar) {
    const today = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][new Date().getDay()];
    bar.querySelectorAll('[data-venue-link]').forEach((node) => {
      const link = node as HTMLElement;
      const label = link.querySelector('[data-venue-hours]');
      try {
        const map = JSON.parse(link.dataset.hours ?? '{}') as Record<string, string>;
        if (label && map[today]) label.textContent = map[today];
      } catch {
        /* keep the server-rendered day */
      }
    });
  }
</script>
