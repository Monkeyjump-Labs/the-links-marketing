---
/**
 * Two venues, one site. The switcher — not a nav item — is how the second venue
 * stays discoverable without spending a nav slot (sitemap.md §2).
 * Progressive enhancement: renders as real links, so it works with JS off.
 */
import { getVenues, venuePath } from '../../lib/venues';

const venues = await getVenues();
const currentPath = Astro.url.pathname;
---

<div class="flex items-center gap-1 text-sm" data-venue-switcher>
  <span class="mr-1 hidden text-inkMuted sm:inline">Visiting</span>
  {
    venues.map((venue) => (
      <a
        href={venuePath(venue)}
        class:list={[
          'rounded px-2 py-1 font-medium transition hover:bg-ink/5',
          currentPath.startsWith(venuePath(venue)) ? 'bg-ink/10 text-ink' : 'text-inkMuted',
        ]}
        data-venue={venue.data.slug}
      >
        {venue.data.shortName}
      </a>
    ))
  }
</div>

<script>
  // Remember the chosen venue so /book can pre-select it. Preference only —
  // every link above already works without this.
  document.querySelectorAll('[data-venue-switcher] [data-venue]').forEach((el) => {
    el.addEventListener('click', () => {
      try {
        localStorage.setItem('preferredVenue', (el as HTMLElement).dataset.venue ?? '');
      } catch {
        /* private browsing — preference is optional */
      }
    });
  });
</script>
