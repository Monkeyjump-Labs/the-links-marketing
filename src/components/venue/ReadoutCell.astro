---
/**
 * A labelled cell: a caps label over a value. The atom the scoreboard is built
 * from — a fact is never a naked string on this site, it is a cell with a name
 * on it, so a visitor can find the one they came for without reading a
 * paragraph.
 *
 * The typesetting now lives in `lib/readout.ts`, because `GapCell` has to match
 * it EXACTLY — a gap is typeset like the filled cell beside it, and two
 * components each keeping their own copy of the size map is how that stops being
 * true. See that file for the rule and the contrast arithmetic behind `tone`.
 */
import {
  READOUT_VALUE,
  READOUT_LABEL,
  READOUT_VALUE_TONE,
  type ReadoutSize,
  type ReadoutTone,
} from '../../lib/readout';

interface Props {
  label: string;
  tone?: ReadoutTone;
  size?: ReadoutSize;
  class?: string;
}

const { label, tone = 'light', size = 'xl', class: className = '' } = Astro.props;
---

<div class:list={[className]}>
  <p class:list={['caps-label text-label-sm', READOUT_LABEL[tone]]}>{label}</p>
  <p class:list={['mt-s2', READOUT_VALUE[size], READOUT_VALUE_TONE[tone]]}><slot /></p>
</div>
