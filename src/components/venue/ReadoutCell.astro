---
/**
 * A labelled cell: a caps label over a value. The atom the scoreboard is built
 * from — a fact is never a naked string on this site, it is a cell with a name
 * on it, so a visitor can find the one they came for without reading a
 * paragraph.
 *
 * The value slot takes the `scoreboard` treatment at `xl`/`md` (tabular, lining,
 * expanded, 800) because published figures are the brand's proof; `text` is for
 * a value that is words rather than a figure.
 *
 * `tone` names the GROUND, because the muted label colour differs by it and
 * getting it wrong is an arithmetic failure, not a preference:
 *   light  → ink.mutedOnLight  6.87:1 on white
 *   dark   → ink.mutedOnDark   5.48:1 on midnight (midnight ONLY — 4.16:1 on
 *            navy, which is why muted text never appears in a hoverable row)
 */
interface Props {
  label: string;
  tone?: 'light' | 'dark';
  size?: 'xl' | 'md' | 'name' | 'text';
  class?: string;
}

const { label, tone = 'light', size = 'xl', class: className = '' } = Astro.props;

const labelTone = tone === 'dark' ? 'text-slate' : 'text-inkMuted';
const valueTone = tone === 'dark' ? 'text-white' : 'text-ink';
const valueSize = {
  xl: 'scoreboard text-score-xl leading-score',
  md: 'scoreboard text-score-md leading-score',
  // A value that is a NAME rather than a figure — a product, a technology.
  // Display face, not the numeric one: tabular figures on a word are noise.
  name: 'font-display text-card leading-display font-bold tracking-display',
  text: 'text-small leading-body',
}[size];
---

<div class:list={[className]}>
  <p class:list={['caps-label text-label-sm', labelTone]}>{label}</p>
  <p class:list={['mt-s2', valueSize, valueTone]}><slot /></p>
</div>
