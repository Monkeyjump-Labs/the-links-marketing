---
/**
 * The primary CTA. Booking is offsite on Whoosh (decision #5), so the button
 * SAYS where it goes — playbook core.md §6: "never link out mid-funnel without
 * warning". Without a venue it routes to /book, which asks which one.
 */
import type { Venue } from '../../lib/venues';
import { buttonClasses, type ButtonSize, type ButtonVariant } from '../../lib/buttons';

interface Props {
  venue?: Venue;
  label?: string;
  size?: ButtonSize;
  /**
   * `solid`/`outline` are for LIGHT surfaces. On a dark field use `onDark`
   * (amber fill, midnight ink) or `ghostDark` (paper outline).
   *
   * This is not cosmetic. A solid ember fill on the midnight hero measures
   * 2.35:1 — `rules.noEmberOnDark` — and that is the same measurement as
   * `noDarkOnAccentBand` read the other way round. `semantic.primary.onDarkFill`
   * answers it: an amber fill with midnight ink is 9.48:1 in both directions,
   * so the action keeps a colour on the band the visitor sees most.
   *
   * (This component used to render a paper fill on dark. It cleared AA but it
   * was not the system — the divergence STYLE-GUIDE §10 flagged is now closed.)
   */
  variant?: 'solid' | ButtonVariant;
  class?: string;
}

const { venue, label, size = 'md', variant = 'solid', class: className = '' } = Astro.props;

const href = venue ? venue.data.bookingUrl : '/book/';
const isExternal = Boolean(venue);
const text = label ?? (venue ? `Book at ${venue.data.shortName}` : 'Book a Bay');

// `solid` is the starter's name for the light-ground fill; the token layer
// calls it `primary`. Both are accepted so no other page has to change.
const resolved: ButtonVariant = variant === 'solid' ? 'primary' : variant;
---

<a
  href={href}
  class:list={[buttonClasses(size, resolved), className]}
  {...isExternal ? { target: '_blank', rel: 'noopener' } : {}}
  data-analytics={venue ? `book:${venue.data.slug}` : 'book:chooser'}
>
  {text}{isExternal && <span aria-hidden="true">→</span>}
  {isExternal && <span class="sr-only">(opens Whoosh booking in a new tab)</span>}
</a>
