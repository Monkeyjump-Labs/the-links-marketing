---
/**
 * The primary CTA. Booking is offsite on Whoosh (decision #5), so the button
 * SAYS where it goes — playbook core.md §6: "never link out mid-funnel without
 * warning". Without a venue it routes to /book, which asks which one.
 */
import type { Venue } from '../../lib/venues';

interface Props {
  venue?: Venue;
  label?: string;
  size?: 'sm' | 'md' | 'lg';
  /**
   * `solid`/`outline` are for LIGHT surfaces. On a dark field use `onDark`.
   *
   * This is not cosmetic: an ember fill on the forest-green hero measures
   * 1.36:1 — effectively invisible. A solid action colour on a near-black field
   * is mathematically unreachable here (white text at 4.5:1 caps the fill's
   * luminance below the level a 3:1 boundary against #124B2E demands), so on
   * dark the CTA inverts to a paper fill instead. See brand-direction.md.
   */
  variant?: 'solid' | 'outline' | 'onDark';
  class?: string;
}

const { venue, label, size = 'md', variant = 'solid', class: className = '' } = Astro.props;

const href = venue ? venue.data.bookingUrl : '/book/';
const isExternal = Boolean(venue);
const text = label ?? (venue ? `Book at ${venue.data.shortName}` : 'Book a Bay');

// min-h-tap on every size: these are controls, and size.tapMin is a hard floor.
const sizes = {
  sm: 'min-h-tap px-4 py-2 text-sm',
  md: 'min-h-tap px-6 py-3 text-base',
  lg: 'min-h-tap px-8 py-4 text-lg',
};
const variants = {
  solid: 'bg-primary text-surface hover:opacity-90',
  outline: 'border-2 border-current text-ink hover:bg-ink hover:text-surface',
  onDark: 'bg-surface text-ink hover:opacity-90',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded font-semibold transition',
    sizes[size],
    variants[variant],
    className,
  ]}
  {...isExternal ? { target: '_blank', rel: 'noopener' } : {}}
  data-analytics={venue ? `book:${venue.data.slug}` : 'book:chooser'}
>
  {text}{isExternal && <span aria-hidden="true"> →</span>}
  {isExternal && <span class="sr-only">(opens Whoosh booking in a new tab)</span>}
</a>
