---
/**
 * The gift-card pop-up: a flyer-style card that opens once, a few seconds after
 * a visitor lands, and then stays away for a week. It replaced the membership
 * pop-up on 2026-11-27 (owner: drive gift-card purchases).
 *
 * ── IT MUST NOT GET IN THE WAY OF BOOKING ──────────────────────────────────
 * The primary action on this site is "Book a bay". So the pop-up waits (it never
 * opens in the first few seconds, when a returning customer is already tapping
 * Book), it is one tap or Escape to close, it is shown at most once a week per
 * browser, and it is suppressed on `/gift-cards/` itself and on the pages
 * `BaseLayout` already opts out of the subscribe strip for.
 *
 * ── EVERY CLAIM HERE COMES FROM `/gift-cards/` ─────────────────────────────
 * Amount range, what a card covers, delivery, expiry and the one-venue
 * restriction were all verified with the owner on 2026-09-20 and are published
 * on that page. If one changes there, change it here. No bonus, discount or
 * deadline belongs here unless the owner has supplied it.
 *
 * The button goes to `/gift-cards/`, never straight to Square: the buyer has to
 * choose a venue, and that page explains why before they do.
 *
 * Native `<dialog>`: focus trap, Escape, and the backdrop come from the browser.
 * Without JavaScript it simply never opens.
 */
import { Image } from 'astro:assets';
import { buttonClasses } from '../../lib/buttons';
import flyerPhoto from '../../assets/images/lakeville-bays.jpg';

const facts = [
  { label: 'You choose the amount', text: 'Anything from $5 to $1,000.' },
  { label: 'No expiry date', text: 'It never expires.' },
];
---

<dialog
  class="m-auto w-11/12 max-w-content overflow-visible border-0 bg-transparent p-0 backdrop:bg-midnight/70"
  aria-labelledby="gift-card-promo-title"
  data-gift-promo
>
  <div class="on-dark relative grid overflow-hidden bg-midnight md:grid-cols-2">
    <div class="relative hidden min-h-full md:block">
      <Image
        src={flyerPhoto}
        alt="Golf simulator bays and the bar at The Links of Lakeville"
        widths={[480, 720]}
        sizes="(min-width: 768px) 450px, 0px"
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
      />
    </div>

    <div class="max-h-svh overflow-y-auto p-s6 pt-s7 lg:p-s7">
      <p class="caps-label text-amber">Gift cards</p>
      <h2
        id="gift-card-promo-title"
        class="mt-s4 font-display text-hero leading-hero font-extrabold tracking-display-tight text-white"
      >
        Give a night of golf.
      </h2>
      <p class="mt-s4 text-body leading-body text-paper">
        Good for bay time, food and drink. Have it sent by email, or come in for a card you can hand over.
      </p>

      <ul class="mt-s5 border-t-hairline border-paper/30">
        {
          facts.map((f) => (
            <li class="border-b-hairline border-paper/30 py-s4">
              <p class="caps-label text-label-sm text-amber">{f.label}</p>
              <p class="mt-s2 text-body text-paper">{f.text}</p>
            </li>
          ))
        }
      </ul>

      <p class="mt-s5 border-l-slab border-amber pl-s4 text-small leading-body text-paper">
        A gift card only works at the location it was bought from: Lakeville or Stillwater.
      </p>

      <div class="mt-s6 flex flex-wrap gap-s4">
        <a href="/gift-cards/" class={buttonClasses('md', 'onDark')} data-analytics="gift-card-promo-cta">
          Buy a gift card
        </a>
        <button type="button" class={buttonClasses('md', 'ghostDark')} data-promo-close>Maybe later</button>
      </div>
    </div>

    <button
      type="button"
      class="absolute top-s2 right-s2 flex min-h-tap min-w-tap items-center justify-center text-score-md text-paper transition-colors duration-fast ease-standard hover:text-amber"
      data-promo-close
      aria-label="Close the gift card message"
    >
      <span aria-hidden="true">&times;</span>
    </button>
  </div>
</dialog>

<script is:inline>
  (function () {
    var KEY = 'links:gift-card-promo-seen';
    var WEEK = 7 * 24 * 60 * 60 * 1000;
    var dlg = document.querySelector('[data-gift-promo]');
    if (!dlg || typeof dlg.showModal !== 'function') return;

    try {
      var seen = Number(window.localStorage.getItem(KEY));
      if (seen && Date.now() - seen < WEEK) return;
    } catch {
      /* storage blocked — show it; once per page load is the safe failure */
    }

    function remember() {
      try {
        window.localStorage.setItem(KEY, String(Date.now()));
      } catch {
        /* nothing to do */
      }
    }

    dlg.addEventListener('close', remember);
    dlg.addEventListener('click', function (e) {
      // A click on the backdrop lands on the <dialog> itself, not its content.
      if (e.target === dlg || e.target.closest('[data-promo-close]')) dlg.close();
      else if (e.target.closest('a')) remember();
    });

    setTimeout(function () {
      if (!dlg.open) dlg.showModal();
    }, 4000);
  })();
</script>
