---
/** "a, b and c" — an Oxford-less list, because it is read as a sentence. */
function formatList(items: string[]): string {
  if (items.length <= 1) return items[0] ?? '';
  return `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;
}
import { orderedHours, formatTime, type Venue } from '../../lib/venues';

interface Props {
  venue: Venue;
}
const { venue } = Astro.props;
const rows = orderedHours(venue);
---

<table class="w-full text-left text-sm">
  <caption class="sr-only">Opening hours for {venue.data.name}</caption>
  <tbody>
    {
      rows.map((row) => (
        <tr class="border-b border-ink/10 last:border-0">
          <th scope="row" class="py-2 pr-4 font-medium">
            {row.day}
          </th>
          <td class="py-2 text-inkMuted">
            {row.closed ? 'Closed' : `${formatTime(row.opens)} – ${formatTime(row.closes)}`}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
{venue.data.hoursNote && <p class="mt-3 text-xs text-inkMuted">{venue.data.hoursNote}</p>}

{
  /* Standing annual closures, stated as a rule rather than reconciled against
    the week on screen. The client's instruction (client-answers.md §1) is to
    publish them "regardless of where they fall this year" — Labor Day sits
    inside the published schedule, and saying so here is cheaper than somebody
    driving to a locked door. */
}
{
  venue.data.closedHolidays.length > 0 && (
    <p class="mt-2 text-xs text-inkMuted">Closed every summer/fall on {formatList(venue.data.closedHolidays)}.</p>
  )
}
