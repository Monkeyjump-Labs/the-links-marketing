---
/**
 * One league, as a **venue block on a ruled grid** — not a card.
 *
 * Cards were the previous answer and convergence rejected them here: a card is a
 * container for a thing you can choose between, and these two are not
 * alternatives — they are the same league at two venues, one of which has never
 * run one before. Boxing them side by side implies a choice and hides that the
 * two rows carry different amounts of truth. A ruled block puts them in one
 * column at one scale, with the season facts in the same labelled cells the rest
 * of the site uses.
 *
 * **The six season facts are the gap system's main event on this page.** They
 * render as `GapCell`s marked *Not yet set* — same label, same size, an em-dash
 * in the value slot — so the row reads as "the venue has not decided" rather
 * than as a page we abandoned. When the client supplies a night, the gap becomes
 * a `ReadoutCell` and nothing else on the page moves.
 *
 * **`status: 'archive'` is last season, drawn disabled.** Lakeville's four
 * documented leagues have already run, so they are shown as reference rather
 * than as something to join: no register link, no waitlist form of their own,
 * and a "Last season — closed" tag in the slot that normally carries the
 * registration state. It is a DATA state and not a page branch, so the client
 * flips a row back to `live` in Tina when the 2026 lineup lands and the block
 * starts taking signups again without anyone touching this file.
 *
 * **The disabled treatment cannot be "put it on greige".** A `notSet` cell tints
 * itself greige on a light ground, and a tint the same colour as its ground is
 * not a tint — the mark would keep its words and lose the form that separates it
 * from a `quoted` one (`GapCell` §"Which band a notSet cell can sit on"). Nor
 * can it be an opacity fade, which takes the facts the block exists to show down
 * with it and puts the whole grid under the audit's contrast floor. So an
 * archived block stays on white and is muted with TYPE: an ink-muted heading, a
 * navy rule where a live block carries the ember one, and the action slot
 * replaced by the check-back note. Every measured pairing stays as it was.
 *
 * Leagues are the worst-executed page type in the corpus: 46% offer no way to
 * register, 50% state no price, 67% give no beginner reassurance. Every block
 * still ends in an action — an archived one points at the page's waitlist band
 * rather than dead-ending on a season nobody can join.
 */
import type { CollectionEntry } from 'astro:content';
import WaitlistForm from './WaitlistForm.astro';
import ReadoutCell from './ReadoutCell.astro';
import GapCell from './GapCell.astro';
import { buttonClasses } from '../../lib/buttons';
import { LEAGUE_WAITLIST_ID, formatLeagueDate } from '../../lib/leagues';

interface Props {
  league: CollectionEntry<'leagues'>;
  /** First block carries the heavy top rule; the rest carry a hairline. */
  first?: boolean;
  last?: boolean;
}
const { league, first = false, last = false } = Astro.props;
const d = league.data;

const isArchive = d.status === 'archive';

const stateLabel = isArchive
  ? 'Last season — closed'
  : {
      open: 'Registration open',
      full: 'Full — waitlist open',
      between: 'Between seasons',
    }[d.state];

/**
 * The six facts, in the order a player asks for them. `value: undefined` is not
 * a missing row — it is a row whose value is a gap, and it still renders.
 * Dropping the row instead would hide that the question exists, which is the
 * thing the season track promises we will not do.
 *
 * **An archived row swaps two cells, and both swaps are about not lying.**
 *
 * *Starts* comes out: a date on a season that finished in December is a fact
 * about the past sitting in the slot a reader uses to answer "when can I play".
 *
 * *Cost* splits into **Entry fee** and **Skins**, and the entry fee is left
 * empty on purpose so it draws the *Not yet set* mark. Every archived spec
 * states a skins buy-in and NONE of them states an entry fee, so a single "Cost"
 * cell would have to take one figure and call it the price of joining. Two cells
 * can say exactly what is known and exactly what is not.
 */
const facts: { label: string; value?: string; reason?: string }[] = isArchive
  ? [
      { label: 'Nights', value: d.night },
      { label: 'Format', value: d.format },
      { label: 'Length', value: d.weeks ? `${d.weeks} weeks` : undefined },
      { label: 'Skins', value: d.skins },
      {
        label: 'Entry fee',
        value: d.price,
        reason:
          'Last season’s sheets set the skins pot and nothing else, so what that season cost to enter was never written down. The 2026 fall nights above state their own fee.',
      },
      { label: 'Prizes', value: d.prizes },
    ]
  : [
      { label: 'Night', value: d.night },
      { label: 'Format', value: d.format },
      { label: 'Length', value: d.weeks ? `${d.weeks} weeks` : undefined },
      { label: 'Starts', value: formatLeagueDate(d.startDate) },
      { label: 'Cost', value: d.price },
      { label: 'Prizes', value: d.prizes },
    ];
---

<article
  class:list={['border-navy py-s7', first ? 'border-t-score' : 'border-t-hairline', last && 'border-b-score']}
  data-league-status={d.status}
>
  <div class="flex flex-wrap items-baseline justify-between gap-s4">
    <h3
      class:list={[
        'text-row leading-display font-extrabold tracking-display',
        /* Archived: ink-muted, 6.87:1 on white. A heading at full ink weight
           reads as the thing to act on, which this one is not. */
        isArchive ? 'text-inkMuted' : 'text-ink',
      ]}
    >
      {d.name}
    </h3>
    <p class="caps-label text-label-sm text-inkMuted">{stateLabel} · {d.season}</p>
  </div>

  <p class="mt-s4 max-w-prose-page text-lead leading-body text-inkBody">{d.oneLiner}</p>

  {
    /* Beginner reassurance is REQUIRED, not optional: it is the top reason
      people do not join, and two thirds of the corpus omits it entirely. It
      carries the 8px slab so it reads as the page's own voice rather than as
      another fact in the grid — in NAVY on an archived block, because ember is
      the action colour and an archived block has no action in it. */
  }
  <p
    class:list={[
      'mt-s5 max-w-prose-page border-l-slab pl-s4 text-body leading-body text-inkBody',
      isArchive ? 'border-navy' : 'border-ember',
    ]}
  >
    {d.beginnerNote}
  </p>

  <div class="mt-s6 grid grid-cols-2 gap-s5 border-y-quiet border-navy py-s5 md:grid-cols-3">
    {
      facts.map((fact) =>
        fact.value ? (
          <ReadoutCell label={fact.label} size="name">
            {fact.value}
          </ReadoutCell>
        ) : (
          <GapCell label={fact.label} state="notSet" size="name" reason={fact.reason} />
        ),
      )
    }
  </div>

  <div class="mt-s6">
    {
      /* An archived season has no action of its own — the register link and the
        per-league waitlist would both be offers on something that has already
        finished. It gets the check-back note and a route to the one live action
        on the page instead, so the block still ends in somewhere to go. */
      isArchive && (
        <>
          {d.nextSeasonNote && <p class="max-w-prose-page text-small leading-body text-inkMuted">{d.nextSeasonNote}</p>}
          <p class="mt-s4">
            <a
              href={`#${LEAGUE_WAITLIST_ID}`}
              class="inline-flex min-h-tap items-center font-bold text-inkBody underline decoration-2 underline-offset-4 transition-colors duration-fast ease-standard hover:text-ember"
              data-analytics={`league-archive-waitlist:${league.id}`}
            >
              Get first word when the new schedule lands <span aria-hidden="true">→</span>
            </a>
          </p>
        </>
      )
    }
    {
      !isArchive && d.state === 'open' && d.registerUrl && (
        <a
          href={d.registerUrl}
          target="_blank"
          rel="noopener"
          class={buttonClasses('md', 'primary')}
          data-analytics={`league-register:${league.id}`}
        >
          Register now <span aria-hidden="true">→</span>
        </a>
      )
    }
    {
      !isArchive && d.state !== 'open' && (
        <>
          {d.nextSeasonNote && (
            <p class="mb-s5 max-w-prose-page text-small leading-body text-inkMuted">{d.nextSeasonNote}</p>
          )}
          <WaitlistForm
            listName={`league-${league.id}`}
            venue={d.venue}
            heading={d.state === 'full' ? 'Join the waitlist' : 'Tell me when it opens'}
          />
        </>
      )
    }
  </div>

  {
    d.standingsUrl && (
      <p class="mt-s5">
        <a
          href={d.standingsUrl}
          class="inline-flex min-h-tap items-center font-bold text-inkBody underline decoration-2 underline-offset-4 transition-colors duration-fast ease-standard hover:text-ember"
          target="_blank"
          rel="noopener"
        >
          Current standings and results
        </a>
      </p>
    )
  }
</article>
