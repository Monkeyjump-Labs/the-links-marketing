---
/**
 * THE differentiator. Across all 126 audited simulator and golf-course sites,
 * exactly ZERO offered a waitlist, while 11% of league pages say "registration
 * closed" and simply stop (playbook-core.md §5).
 *
 * On the two corpus figures: 126 is the WHOLE playbook audit (sim venues plus
 * golf courses, `_playbook/audit-findings.md`); the 96 quoted in `data/global.ts`
 * is the sim-venue SUBSET that `playbook-sim-venue.md` is measured on. Both are
 * right. Name which one you mean whenever you cite either.
 *
 * And keep it internal: "zero of 126 competitors" is a competitive claim about
 * named third parties, sourced to research the client cannot see. It belongs in
 * comments and in our own documents, not in copy a customer reads. Nothing
 * customer-facing carries it today — do not be the one who adds it.
 *
 * Posts to PUBLIC_LEAD_ENDPOINT. With no endpoint configured it degrades to a
 * mailto so a lead is never silently dropped, and it says so rather than
 * pretending.
 *
 * **It is a paper slab, and on the ember band it is punched out of it.** Nothing
 * dark is legible on ember — midnight 2.35:1, navy 1.79:1 — so the form cannot
 * simply sit on the band (`rules.noDarkOnAccentBand`). Inside the slab
 * everything reverts to light-field styling: navy heading 12.24:1, navyMid body
 * 9.13:1, inkMuted placeholders 6.32:1, paper on an ember submit 6.85:1. The
 * `on-light` class restores the light-ground focus slab inside the dark band.
 */
import { buttonClasses } from '../../lib/buttons';

interface Props {
  heading?: string;
  blurb?: string;
  listName: string;
  venue?: string;
  email?: string;
  class?: string;
}

const {
  heading = 'Join the list',
  blurb = 'We will email you the moment registration opens. No other mail, ever.',
  listName,
  venue,
  email = 'info@lakevillelinks.com',
  class: className = '',
} = Astro.props;

const endpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT;
const formId = `waitlist-${listName.replace(/\W+/g, '-').toLowerCase()}`;

const field =
  'min-h-tap min-w-0 rounded-control border-rule border-navy bg-white px-s4 py-s3 text-body text-navy placeholder:text-inkMuted';
---

<div class:list={['on-light rounded-surface bg-paper p-cell-lg text-inkBody', className]}>
  <h3 class="text-row leading-display font-extrabold tracking-display text-ink">{heading}</h3>
  <p class="mt-s3 text-small leading-body text-inkBody">{blurb}</p>

  <form
    class="mt-s5"
    action={endpoint ?? `mailto:${email}`}
    method={endpoint ? 'POST' : 'GET'}
    data-analytics={`waitlist:${listName}`}
    id={formId}
  >
    <input type="hidden" name="list" value={listName} />
    {venue && <input type="hidden" name="venue" value={venue} />}
    <input type="text" name="_hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    <div class="grid gap-s4 sm:grid-cols-2">
      <div class="flex flex-col">
        <label class="sr-only" for={`${formId}-name`}>Your name</label>
        <input id={`${formId}-name`} name="name" type="text" required placeholder="Your name" class={field} />
      </div>
      <div class="flex flex-col">
        <label class="sr-only" for={`${formId}-email`}>Email address</label>
        <input id={`${formId}-email`} name="email" type="email" required placeholder="you@example.com" class={field} />
      </div>
    </div>

    <button type="submit" class:list={[buttonClasses('md', 'primary'), 'mt-s5 w-full cursor-pointer']}>
      Notify me
    </button>
  </form>

  {
    !endpoint && (
      <p class="mt-s5 border-t-hairline border-inkMuted pt-s4 text-small leading-body text-inkMuted">
        Lead endpoint not configured — this form opens an email instead.
      </p>
    )
  }
</div>
