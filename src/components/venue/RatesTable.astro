---
/**
 * Prices as HTML text, never an image — the current site's worst defect.
 * Each row carries its own eligibility window (adopted from onthegreen-golf.com).
 * Seasonality is a FIELD on this page, never a second page.
 */
import type { CollectionEntry } from 'astro:content';
import { getVenues, appliesTo } from '../../lib/venues';

interface Props {
  card: CollectionEntry<'rates'>;
}
const { card } = Astro.props;
const venues = await getVenues();
const d = card.data;
---

<section class="mt-10 first:mt-0">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-2xl font-semibold">{d.season}</h2>
    {d.current && <span class="rounded-full bg-primary px-3 py-1 text-xs font-semibold text-surface">Current</span>}
  </div>
  {
    (d.effectiveFrom || d.effectiveTo) && (
      <p class="mt-1 text-sm text-inkMuted">
        {d.effectiveFrom && <>From {d.effectiveFrom}</>}
        {d.effectiveTo && <> to {d.effectiveTo}</>}
      </p>
    )
  }

  {/* tabindex makes the scroll region keyboard-reachable (axe: scrollable-region-focusable) */}
  <div class="mt-4 overflow-x-auto" tabindex="0" role="region" aria-label={`${d.season} rates`}>
    <table class="w-full min-w-[36rem] text-left text-sm">
      <thead>
        <tr class="border-b-2 border-ink/20">
          <th scope="col" class="py-2 pr-4">What</th>
          <th scope="col" class="py-2 pr-4">Price</th>
          <th scope="col" class="py-2 pr-4">When it applies</th>
          <th scope="col" class="py-2">Where</th>
        </tr>
      </thead>
      <tbody>
        {
          d.rows.map((row) => (
            <tr class="border-b border-ink/10">
              <th scope="row" class="py-3 pr-4 font-medium">
                {row.label}
              </th>
              <td class="py-3 pr-4 font-semibold">{row.price}</td>
              <td class="py-3 pr-4 text-inkMuted">{row.eligibility ?? '—'}</td>
              <td class="py-3 text-inkMuted">
                {row.venue === 'both'
                  ? 'Both venues'
                  : venues.find((v) => appliesTo(row.venue, v.data.slug))?.data.shortName}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {d.note && <p class="mt-3 text-sm text-inkMuted">{d.note}</p>}
</section>
