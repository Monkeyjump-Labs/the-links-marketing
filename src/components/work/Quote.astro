---
interface Props {
  quoteText: string;
  quoteSource?: string;
  quoteSourceUrl?: string;
}

const { quoteText, quoteSource, quoteSourceUrl } = Astro.props;
---

<blockquote class="border-l-4 border-grape bg-offWhite px-8 py-6 lg:px-16 lg:py-8 mx-6 lg:mx-16 my-12 lg:my-20">
  <p class="font-mono font-normal text-lg lg:text-3xl leading-relaxed text-softBlack mb-4">{quoteText}</p>
  {
    quoteSource && (
      <cite class="font-sans not-italic text-sm uppercase tracking-wide text-softBlack">
        {quoteSourceUrl ? (
          <a href={quoteSourceUrl} target="_blank" rel="noopener" class="text-grape underline">
            {quoteSource}
          </a>
        ) : (
          quoteSource
        )}
      </cite>
    )
  }
</blockquote>
