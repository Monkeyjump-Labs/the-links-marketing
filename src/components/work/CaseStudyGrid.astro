---
import CaseStudyCard from './CaseStudyCard.astro';
import { getGridCaseStudies } from '../../lib/caseStudies';

interface Props {
  heading?: string;
}

const { heading } = Astro.props;
const linkedStudies = await getGridCaseStudies();
---

<section class="max-w-content mx-auto px-6 lg:px-16 py-12 lg:py-20">
  {
    heading && (
      <h2 class="font-mono font-normal text-softBlack text-3xl lg:text-5xl leading-tight mb-10 lg:mb-20">{heading}</h2>
    )
  }
  <ul class="list-none p-0 m-0 grid grid-cols-1 xl:grid-cols-2 gap-12">
    {
      linkedStudies.map((study) => (
        <li class="flex">
          <CaseStudyCard study={study} />
        </li>
      ))
    }
  </ul>
</section>
