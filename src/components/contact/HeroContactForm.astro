---
import ContactForm from './ContactForm';

interface Props {
  heading?: string;
  buttonText?: string;
}

const { heading, buttonText } = Astro.props;
---

<section class="px-6 pt-32 pb-12 min-h-[80vh] mt-28 lg:px-16 lg:py-20 lg:flex lg:items-center">
  <ContactForm client:visible heading={heading} buttonText={buttonText} />
</section>
