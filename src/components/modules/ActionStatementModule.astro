---
interface Props {
  heading?: string;
  subHeading?: string;
}

const { heading, subHeading } = Astro.props;
---

<section class="mx-auto my-16 max-w-content px-6 lg:my-24 lg:px-16">
  {heading && <h2 class="font-mono text-2xl font-normal leading-tight text-softBlack lg:text-5xl">{heading}</h2>}
  {
    subHeading && (
      <p class="my-8 max-w-2xl font-sans text-base leading-relaxed text-softBlack lg:mb-14 lg:text-xl">{subHeading}</p>
    )
  }
  <svg
    class="block h-8 w-8 text-softBlack lg:h-12 lg:w-12"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</section>
