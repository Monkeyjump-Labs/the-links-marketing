---
/**
 * Footer NAP must match each Google Business Profile character-for-character
 * (playbook-core.md §7). Both venues appear — a two-venue operator whose footer
 * shows one address is the defect we are fixing.
 */
import { getVenues, summariseHours, formatAddress, telHref, venuePath } from '../../lib/venues';
import { globalData } from '../../data/global';

const venues = await getVenues();
const { footerLinks, nav, social, copyright } = globalData;
---

<footer class="border-t-2 border-ink/15 bg-surface">
  <div class="mx-auto max-w-content px-gutter py-12 lg:px-gutter-lg">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      {
        venues.map((venue) => (
          <div>
            <h2 class="text-sm font-semibold tracking-wide uppercase">{venue.data.name}</h2>
            <address class="mt-3 text-sm not-italic text-inkMuted">
              <a href={venuePath(venue)} class="block hover:underline">
                {formatAddress(venue)}
              </a>
              <a href={telHref(venue.data.phone)} class="mt-1 block hover:underline">
                {venue.data.phone}
              </a>
              {venue.data.email && (
                <a href={`mailto:${venue.data.email}`} class="mt-1 block hover:underline">
                  {venue.data.email}
                </a>
              )}
            </address>
            <p class="mt-3 text-sm text-inkMuted">{summariseHours(venue).join(' · ')}</p>
          </div>
        ))
      }

      <nav aria-label="Footer">
        <h2 class="text-sm font-semibold tracking-wide uppercase">Visit</h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm text-inkMuted">
          {
            nav.map((link) => (
              <li>
                <a href={link.href} class="hover:underline">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="More">
        <h2 class="text-sm font-semibold tracking-wide uppercase">More</h2>
        <ul class="mt-3 flex flex-col gap-2 text-sm text-inkMuted">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href} class="hover:underline">
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            social.map((s) => (
              <li>
                <a href={s.href} class="hover:underline" target="_blank" rel="noopener">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-wrap gap-4 border-t border-ink/10 pt-6 text-xs text-inkMuted">
      <span>&copy; {new Date().getFullYear()} {copyright.name}. {copyright.language}</span>
      <a href="/privacy/" class="hover:underline">Privacy</a>
      <a href="/terms/" class="hover:underline">Terms</a>
      <a href="/policy/" class="hover:underline">Booking policy</a>
    </div>
  </div>
</footer>
