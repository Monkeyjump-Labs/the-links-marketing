---
import { globalData } from '../../data/global';

const links = globalData.footer.pageLinks;
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b-2 border-softBlack bg-white">
  <nav class="mx-auto flex max-w-content items-center justify-between px-6 py-4 lg:px-16">
    <a href="/" class="font-mono text-lg font-bold text-softBlack">{globalData.siteName}</a>
    <ul class="flex flex-wrap gap-4 lg:gap-8">
      {
        links
          .filter((link) => link.href !== '/')
          .map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'font-sans text-sm text-softBlack hover:text-grape lg:text-base',
                  currentPath.startsWith(link.href) && link.href !== '/' ? 'font-semibold underline' : '',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
      }
    </ul>
  </nav>
</header>
