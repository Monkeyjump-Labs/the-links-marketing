---
/**
 * The events lead-capture form — and, on that page, **the brightest object on
 * the page**: a white card on midnight.
 *
 * The playbook is explicit about the order: "Lead with a lead-capture form — do
 * not bury it under 1,500 words of packages" (playbook-sim-venue.md §4). Events
 * are the highest revenue per visit in the segment, the visitor is usually a
 * planner rather than a golfer, and the whole page exists to start one
 * conversation. So the form is not a section of the page; it is the object the
 * page is built around, and the composition says so — white on midnight is the
 * strongest contrast the palette can make (17.50:1), spent here and nowhere else.
 *
 * **Headcount and date come first, at scoreboard scale.** They are the two facts
 * the venue needs before it can answer at all, and the two the planner already
 * knows before they arrive. Name and email first — the previous order — asks a
 * stranger to identify themselves before the form has shown it understands what
 * they want. These two take `text-score-md` with tabular figures, so the form
 * opens with the same scoreboard treatment the site gives a published number.
 *
 * "Which venue" stays required. It is the only two-location accommodation
 * anywhere in the current site's forms and it is the one we must not lose.
 *
 * Posts to `/api/lead/` — a fixed, same-origin path. It used to post to
 * `PUBLIC_LEAD_ENDPOINT` and degrade to a `mailto:` when that was unset, which
 * is how this site went live with every form inert. A URL you can configure is
 * a URL you can leave unset, so there is no longer a URL to configure (FW-3975).
 *
 * ⚠️ **Keep the trailing slash on that action.** `trailingSlash: 'always'`
 * applies to API routes as well as pages: under `astro dev`, `POST /api/lead`
 * is a 404 and `POST /api/lead/` works. Production 308s the slashless form, so
 * dropping the slash breaks local testing ONLY — and silently. It must also
 * stay identical to `ENDPOINT` in `LeadFormScript.astro`, which selects forms
 * by `action`. See FW-4023.
 *
 * Works with JavaScript disabled — a native POST gets a 303 to `/thanks/`.
 * `LeadFormScript` upgrades that to an inline confirmation.
 */
import { getVenues } from '../../lib/venues';
import { buttonClasses } from '../../lib/buttons';

interface Props {
  heading?: string;
  blurb?: string;
  listName: string;
  id?: string;
  class?: string;
}

const {
  heading = 'Tell us about your event',
  blurb = 'The date and rough numbers are enough to get a price back. No obligation.',
  listName,
  id,
  class: className = '',
} = Astro.props;

const venues = await getVenues();
const formId = id ?? `enquiry-${listName.replace(/\W+/g, '-').toLowerCase()}`;

// Inside the white card everything reverts to light-field styling — navy on
// white 13.31:1, navyMid body 9.92:1, inkMuted placeholders 6.87:1. `on-light`
// restores the light-ground focus slab inside the dark band.
const field =
  'min-h-tap w-full min-w-0 rounded-control border-rule border-navy bg-white px-s4 py-s3 text-body text-navy placeholder:text-inkMuted';
/** The two lead fields: same control, scoreboard figures. */
const leadField = `${field} scoreboard text-score-md leading-score`;
const labelClass = 'caps-label block text-label-sm text-inkMuted';
---

<div class:list={['on-light bg-white p-cell lg:p-cell-lg', className]}>
  <h2 class="text-section leading-display font-extrabold tracking-display-tight text-ink">{heading}</h2>
  <p class="mt-s3 max-w-prose-page text-body leading-body text-inkBody">{blurb}</p>

  <form
    class="mt-s6"
    action="/api/lead/"
    method="POST"
    data-analytics={`enquiry:${listName}`}
    data-success="Thanks — we have got your enquiry and will come back to you with a price."
    id={formId}
  >
    <input type="hidden" name="list" value={listName} />
    <input type="hidden" name="_page" value={Astro.url.pathname} />
    {/* Filled at runtime by LeadFormScript; absent on the no-JS path, which is accepted. */}
    <input type="hidden" name="_ts" value="" />
    <input type="text" name="_hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    {
      /* The two that matter, first and loud. The 4px rule under them separates
        "what you want" from "who you are" without needing a second heading. */
    }
    <div class="grid gap-s5 border-b-score border-navy pb-s6 sm:grid-cols-2">
      <div>
        <label class={labelClass} for={`${formId}-size`}>How many people</label>
        <input
          id={`${formId}-size`}
          name="groupSize"
          type="number"
          min="1"
          inputmode="numeric"
          placeholder="24"
          class={`mt-s2 ${leadField}`}
        />
      </div>
      <div>
        <label class={labelClass} for={`${formId}-date`}>Date you have in mind</label>
        <input id={`${formId}-date`} name="date" type="date" class={`mt-s2 ${leadField}`} />
      </div>
    </div>

    <div class="mt-s6 grid gap-s5 sm:grid-cols-2">
      <div>
        <label class={labelClass} for={`${formId}-venue`}>Which venue</label>
        <select id={`${formId}-venue`} name="venue" required class={`mt-s2 ${field}`}>
          {venues.map((venue) => <option value={venue.data.slug}>{venue.data.name}</option>)}
          <option value="either">Either — help me choose</option>
        </select>
      </div>
      <div>
        <label class={labelClass} for={`${formId}-name`}>Your name</label>
        <input id={`${formId}-name`} name="name" type="text" required class={`mt-s2 ${field}`} />
      </div>
      <div>
        <label class={labelClass} for={`${formId}-email`}>Email</label>
        <input id={`${formId}-email`} name="email" type="email" required class={`mt-s2 ${field}`} />
      </div>
      <div>
        <label class={labelClass} for={`${formId}-phone`}>Phone</label>
        <input id={`${formId}-phone`} name="phone" type="tel" class={`mt-s2 ${field}`} />
      </div>
      <div class="sm:col-span-2">
        <label class={labelClass} for={`${formId}-message`}>Anything else we should know</label>
        <textarea id={`${formId}-message`} name="message" rows="4" class={`mt-s2 ${field}`}></textarea>
      </div>
    </div>

    <button type="submit" class:list={[buttonClasses('md', 'primary'), 'mt-s6 w-full cursor-pointer']}>
      Send my enquiry
    </button>

    {/* Only ever shown on failure — success replaces the whole form. */}
    <p
      data-lead-status
      role="alert"
      hidden
      class="mt-s4 border-l-slab border-accent pl-s4 text-small leading-body text-inkBody"
    >
    </p>
  </form>
</div>
