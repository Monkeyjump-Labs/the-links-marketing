---
/**
 * Specials. Replaces `/lakeville-specials`, which carried the one Lakeville flyer
 * and nothing for Stillwater. One page, two venue bands — the same shape as
 * `/leagues` — because a special is per location and a visitor should know which
 * venue it belongs to before they read it.
 *
 * Linked from the top nav and the footer, and indexable. The page it replaces was
 * deliberately unlinked and `noIndex`; it was opened up at the owner's request.
 *
 * Every figure below is read off a flyer image, which is the source of truth. The
 * image alone is not enough — prices and offers are HTML text on this site — so
 * the same facts are repeated as text. Change a flyer and its text together.
 * The Stillwater flyer states the bay discount only; nothing is claimed for
 * Stillwater drinks.
 *
 * The gift card band has no flyer. Its facts are the ones published on
 * `/gift-cards/`; if one changes there, change it here.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/venue/SectionHead.astro';
import { buttonClasses } from '../lib/buttons';
import { getVenue } from '../lib/venues';
import turkeyShootoutFlyer from '../assets/images/turkey-shootout-lakeville.webp';
import lakevilleTuesday from '../assets/images/half-price-tuesdays-lakeville.jpg';
import stillwaterTuesday from '../assets/images/half-price-tuesdays-stillwater.webp';

/**
 * SWITCH: Half-Price Tuesdays.
 * `false` hides every Half-Price Tuesdays block on this page (the Lakeville card,
 * the whole Stillwater band, the intro sentence and the search description).
 * Nothing is deleted. To bring it back, change this to `true` and save.
 * While it is off, the Stillwater band does not render, because Tuesdays is its
 * only content.
 */
const showHalfPriceTuesdays = false;

const lakeville = await getVenue('lakeville');
const stillwater = await getVenue('stillwater');

const metadata = {
  metaTitle: 'Specials — The Links, Lakeville & Stillwater MN',
  metaDescription: showHalfPriceTuesdays
    ? 'Half-Price Tuesdays at The Links in Lakeville and Stillwater, the Turkey Shootout contest at Lakeville, and gift cards.'
    : 'The Turkey Shootout contest at The Links of Lakeville, November 23 to December 6, plus gift cards for Lakeville and Stillwater.',
};
---

<BaseLayout metadata={metadata}>
  <section class="on-dark bg-midnight">
    <div class="mx-auto max-w-content px-gutter pt-s8 pb-s7 lg:px-gutter-lg lg:pt-s9 lg:pb-s8">
      <p class="caps-label text-amber">Both locations</p>
      <h1 class="mt-s5 text-hero leading-hero font-extrabold tracking-display-tight text-white">Specials</h1>
      <p class="mt-s5 max-w-prose-page border-l-slab border-amber pl-s4 text-lead leading-body text-paper">
        {
          showHalfPriceTuesdays
            ? 'Half-price simulator bays every Tuesday, at both locations. Lakeville also has specials this week.'
            : 'The Turkey Shootout at our Lakeville location, and gift cards for either location.'
        }
      </p>
    </div>
  </section>

  {/* LAKEVILLE */}
  <section class="scroll-mt-s8 bg-white" id="lakeville">
    <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
      <SectionHead>Lakeville Specials</SectionHead>
      {/* The Turkey Shootout runs Nov 23 to Dec 6. Take it down when those dates pass. */}

      {
        showHalfPriceTuesdays && (
          <article class="border-t-score border-navy py-s7">
            <div class="grid gap-s7 lg:grid-cols-2 lg:items-start lg:gap-s9">
              <Image
                src={lakevilleTuesday}
                widths={[480, 720]}
                width={720}
                quality={60}
                sizes="(min-width: 1024px) 480px, 100vw"
                alt="Flyer for Half-Price Tuesdays at The Links: 50% off all simulator bays, $9 Coors pitchers, and $3 domestic cans, tap and rail drinks."
                class="w-full"
              />
              <div>
                <p class="caps-label text-label-sm text-inkMuted">Every Tuesday · Lakeville Location Only</p>
                <h3 class="mt-s3 text-row leading-display font-extrabold tracking-display text-ink">
                  Half-Price Tuesdays
                </h3>
                <p class="mt-s5 border-l-slab border-ember pl-s4 text-lead leading-body text-inkBody">
                  50% off all simulator bays.
                </p>
                <ul class="mt-s5 list-disc space-y-s2 pl-s6 text-body leading-body text-inkBody">
                  <li>$9 Coors pitchers</li>
                  <li>$3 domestic cans, tap and rail drinks</li>
                </ul>
                {lakeville && (
                  <a
                    href={lakeville.data.bookingUrl}
                    class={buttonClasses('md', 'primary') + ' mt-s6'}
                    target="_blank"
                    rel="noopener"
                    data-analytics="specials:book-lakeville-tuesday"
                  >
                    Book your bay <span aria-hidden="true">→</span>
                    <span class="sr-only">(opens the Lakeville booking page in a new tab)</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        )
      }

      <article class:list={[showHalfPriceTuesdays ? 'border-t-hairline' : 'border-t-score', 'border-navy py-s7']}>
        <div class="grid gap-s7 lg:grid-cols-2 lg:items-start lg:gap-s9">
          <Image
            src={turkeyShootoutFlyer}
            widths={[480, 720]}
            width={720}
            quality={60}
            sizes="(min-width: 1024px) 480px, 100vw"
            alt="Flyer for the Turkey Shootout, a bi-weekly contest at The Links of Lakeville, powered by Fareway: November 23 to December 6, best ball stroke play, 18 holes, teams of 2, $15 per player, with live net and gross leaderboards and automatic payouts. You must make your own tee times."
            class="w-full"
          />
          <div>
            <p class="caps-label text-label-sm text-inkMuted">November 23 to December 6 · Lakeville Location Only</p>
            <h3 class="mt-s3 text-row leading-display font-extrabold tracking-display text-ink">Turkey Shootout</h3>
            <p class="mt-s5 border-l-slab border-ember pl-s4 text-lead leading-body text-inkBody">
              Compete at The Links of Lakeville, climb the leaderboard and get paid.
            </p>
            <ul class="mt-s5 list-disc space-y-s2 pl-s6 text-body leading-body text-inkBody">
              <li>Format: best ball stroke play, 18 holes, teams of 2</li>
              <li>Entry fee: $15 per player</li>
              <li>You must make your own tee times</li>
              <li>Live net and gross leaderboards, with automatic payouts</li>
            </ul>
            <p class="mt-s5 text-body leading-body text-inkBody">
              How to join: download the Fareway app, scan the QR code on the flyer, sign up and start playing. Track
              your live standings in the app.
            </p>
            <a
              href="/contests/"
              class={buttonClasses('md', 'primary') + ' mt-s6'}
              data-analytics="specials:contest-turkey-shootout"
            >
              Register for the contest <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  {/* GIFT CARDS. Same promise as the site pop-up; the button goes to the venue chooser. */}
  <section class="scroll-mt-s8 bg-greige" id="gift-cards">
    <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
      <SectionHead>Gift Cards</SectionHead>
      <article class="border-t-score border-navy py-s7">
        <p class="caps-label text-label-sm text-inkMuted">Lakeville & Stillwater</p>
        <h3 class="mt-s3 text-row leading-display font-extrabold tracking-display text-ink">Give a night of golf</h3>
        <p class="mt-s5 max-w-prose-page border-l-slab border-ember pl-s4 text-lead leading-body text-inkBody">
          Good for bay time, food and drink. Have it sent by email, or come in for a card you can hand over.
        </p>
        <ul class="mt-s5 list-disc space-y-s2 pl-s6 text-body leading-body text-inkBody">
          <li>Any amount from $5 to $1,000</li>
          <li>It never expires</li>
          <li>A gift card only works at the location it was bought from</li>
        </ul>
        <a
          href="/gift-cards/"
          class={buttonClasses('md', 'primary') + ' mt-s6'}
          data-analytics="specials:buy-gift-card"
        >
          Buy a gift card <span aria-hidden="true">→</span>
        </a>
      </article>
    </div>
  </section>

  {/* STILLWATER (Half-Price Tuesdays only; hidden by the switch at the top) */}
  {
    showHalfPriceTuesdays && (
      <section class="scroll-mt-s8 bg-greige" id="stillwater">
        <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
          <SectionHead>Stillwater Specials</SectionHead>

          <article class="border-t-score border-navy py-s7">
            <div class="grid gap-s7 lg:grid-cols-2 lg:items-start lg:gap-s9">
              <Image
                src={stillwaterTuesday}
                widths={[480, 720]}
                width={720}
                quality={60}
                sizes="(min-width: 1024px) 480px, 100vw"
                alt="Flyer for Half-Price Tuesdays at The Links: 50% off all simulator bays."
                class="w-full"
              />
              <div>
                <p class="caps-label text-label-sm text-inkMuted">Every Tuesday · Stillwater Location Only</p>
                <h3 class="mt-s3 text-row leading-display font-extrabold tracking-display text-ink">
                  Half-Price Tuesdays
                </h3>
                <p class="mt-s5 border-l-slab border-ember pl-s4 text-lead leading-body text-inkBody">
                  50% off all simulator bays.
                </p>
                {stillwater && (
                  <a
                    href={stillwater.data.bookingUrl}
                    class={buttonClasses('md', 'primary') + ' mt-s6'}
                    target="_blank"
                    rel="noopener"
                    data-analytics="specials:book-stillwater-tuesday"
                  >
                    Book your bay <span aria-hidden="true">→</span>
                    <span class="sr-only">(opens the Stillwater booking page in a new tab)</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        </div>
      </section>
    )
  }
</BaseLayout>
