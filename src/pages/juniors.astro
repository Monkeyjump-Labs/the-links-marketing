---
/**
 * Junior leagues and camps. The existing junior content is genuinely good and
 * genuinely specific — and it is five months expired while still written in the
 * present tense ("Sign-Up Now"). Undated stale seasonal content is a named
 * anti-pattern (playbook-core.md §9), so this page does two things:
 *
 *   1. Dates the last season explicitly and puts it in the past tense.
 *   2. Uses the `between` registration state — the waitlist is the primary
 *      action, never a dead end (playbook-core.md §5). Zero of 126 audited sites
 *      offer one.
 *
 * ── STUB PASS 2026-08-05 (FW-4013) ─────────────────────────────────────────
 *
 * Two raw `STUB —` blocks rendered here in production, one of them under the
 * heading "Camps" — so a parent looking for a summer camp read our shopping
 * list instead of an answer.
 *
 *   camps          a parent came here to find out whether camps run. They do
 *                  not, and nothing has ever been published. That is an absence
 *                  a customer is looking for, so it takes a `GapCell` and stays
 *                  visible. The four things we need from the client to fill it
 *                  are ours, and go in the `StubNote` beneath.
 *   next season    the 2027 dates and price are already answered in plain
 *                  words at the top of the page ("the next season has not been
 *                  announced", with a waitlist under it), so a second mark for
 *                  them would just say it twice. The 12–18 vs 13–18 conflict is
 *                  a real defect but not ours to resolve by picking one —
 *                  `StubNote`, and a parent of a 12-year-old still deserves an
 *                  answer before launch.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/venue/WaitlistForm.astro';
import BookButton from '../components/venue/BookButton.astro';
import GapCell from '../components/venue/GapCell.astro';
import StubNote from '../components/venue/StubNote.astro';

const metadata = {
  metaTitle: 'Junior Golf Leagues & Camps — Lakeville, MN',
  metaDescription:
    'Junior golf leagues and camps at The Links of Lakeville, MN. Boys and girls divisions, eight weeks of match play, indoors all winter.',
};

/** What the 2026 season actually was. Past tense, dated, and honest about it. */
const lastSeason = [
  ['When it ran', 'Sundays, 11 January to 8 March 2026 — eight weeks.'],
  ['Divisions', 'Girls 3pm–6pm, boys 6pm–9pm.'],
  ['Format', 'Two-person best-ball match play, team against team.'],
  [
    'How the eight weeks worked',
    'Weeks 1–3 open play to establish flights. Weeks 4–6 flight pool play for playoff seeding. Weeks 7–8 playoffs by flight, with a fun day for anyone who did not make them.',
  ],
  ['Team size', 'Two players, plus an optional alternate who could sub in and share the cost.'],
  ['Cost', '$250 per person, $500 per team, payable on or before the league start.'],
];
---

<BaseLayout metadata={metadata}>
  <section class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg">
    <h1 class="text-4xl font-bold lg:text-5xl">Juniors</h1>
    <p class="mt-4 max-w-2xl text-lg text-inkMuted">
      Winter golf for 12- to 18-year-olds at Lakeville. Eight weeks of match play indoors, in flights, so a beginner
      plays beginners and a varsity player gets a real game. High school players use it to keep a swing through
      February.
    </p>

    {/* 1. Registration state first: between seasons. Say it, then give the action. */}
    <section class="mt-10 rounded border-2 border-ink/25 p-6">
      <p class="text-sm font-semibold tracking-widest uppercase text-primary">Between seasons</p>
      <p class="mt-3 max-w-2xl text-inkMuted">
        The 2026 junior league finished on 8 March 2026 and registration is closed. The next season has not been
        announced. Join the list and you will hear the day the dates go up.
      </p>
    </section>

    <div class="mt-10 max-w-2xl">
      <WaitlistForm
        listName="juniors"
        venue="lakeville"
        heading="Tell me when junior sign-ups open"
        blurb="One email when the next junior season is announced, with dates and price. Nothing else, ever."
      />
    </div>

    {/* 2. What the last season was. Dated, past tense, so a parent can judge fit. */}
    <section class="mt-section">
      <h2 class="text-3xl font-bold">What the last season looked like</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        The 2026 season, as it ran. The next one is likely to be similar but nothing here is a commitment — treat it as
        a guide to the shape and the cost, not a booking.
      </p>
      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        {
          lastSeason.map(([term, detail]) => (
            <div>
              <dt class="font-semibold">{term}</dt>
              <dd class="mt-1 text-inkMuted">{detail}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      /* 3. Beginner reassurance. Only 33% of league pages in the corpus do this,
       and for a parent buying on behalf of a nervous 13-year-old it is the whole
       decision (playbook-core.md §5). */
    }
    <section class="mt-section rounded bg-surface p-8">
      <h2 class="text-2xl font-bold">If they have barely played</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        That is what the flights are for. The first three weeks are open play purely to work out who belongs with whom,
        so a first-year player is not put in front of a varsity golfer in week one. It is indoors, it is warm, the
        simulator does the scoring, and nobody is watching from a clubhouse window.
      </p>
      <p class="mt-4 max-w-2xl text-inkMuted">
        If they would rather try it before committing to eight weeks, book an hour in a bay as a family first. Same
        clubs, same screens, no league.
      </p>
    </section>

    {
      /* 4. Camps. Referenced in the sitemap, nothing published — and a parent
        who came here for a summer camp deserves that answer rather than our
        shopping list. So the absence is the content. */
    }
    <section class="mt-section">
      <h2 class="text-3xl font-bold">Camps</h2>
      <div class="mt-6 max-w-prose-page">
        <GapCell
          label="Junior camps"
          state="notSet"
          size="name"
          reason="No junior camp has ever been published here, so there is nothing to sign up for over the summer yet. If a week of camp is what you are after, join the list above and say so — it is the sort of thing that happens when enough people ask."
        />
      </div>
      <StubNote
        class="mt-6"
        needs="Camps are a May–August revenue line in the playbook's seasonal calendar and this venue currently sells nothing into a Minnesota school holiday. Needed from the client: whether camps run at all and in which school holidays; dates, age bands, day length and price; who runs them — one of the four coaches, or venue staff; and whether Stillwater runs junior programmes of any kind."
      />
    </section>

    {/* 5. Everything else outstanding on this page. */}
    <StubNote
      class="mt-section"
      needs="Three things block the next season going live here: the 2027 dates, the 2027 price, and the age range. The current site says 12–18 on the junior league page and 13–18 on the junior LinksFlex package — one of them is wrong and a parent of a 12-year-old will notice. Do not resolve it by picking one; this page states 12–18 in its hero and 13–18 in the LinksFlex section and will keep doing so until the client says which is right."
    />

    {/* 6. Prepaid junior hours — the thing they can buy today. */}
    <section class="mt-section">
      <h2 class="text-3xl font-bold">Between seasons, they can still play</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        Junior LinksFlex blocks give 13- to 18-year-olds prepaid bay hours from $20.81 an hour, weekday afternoons at
        Lakeville. There is no expiry date on the hours, so an unused block carries into next winter — the
        <a href="/memberships/#before-you-join" class="font-semibold underline">LinksFlex small print</a> has the one condition
        attached to that.
      </p>
      <a href="/memberships/" class="mt-4 inline-block font-semibold underline">See junior LinksFlex prices</a>
    </section>

    {/* Every page ends in a transactional CTA (playbook-core.md §6). */}
    <section class="mt-section rounded bg-surface p-8">
      <h2 class="text-2xl font-bold">Bring them for an hour first</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        A bay is priced by the hour, not the person, so a parent and two kids costs the same as one adult on their own.
      </p>
      <div class="mt-6"><BookButton size="lg" /></div>
    </section>
  </section>
</BaseLayout>
