---
/**
 * The transaction. No marketing interstitial (playbook sim-venue.md §4) — the
 * current site's "ACKNOWLEDGE AND GO TO BOOKING" wall is deleted.
 * Booking is offsite on Whoosh, two separate club accounts, so this page's job
 * is to ask which venue and then get out of the way.
 *
 * ── WALK-INS: GAP CLOSED 2026-09-03 ────────────────────────────────────────
 *
 * "Walk-ins" was the worked example of the gap system. It first answered itself
 * with the string "STUB — walk-in policy needs confirming with the client",
 * printed in the answer slot of a question a customer had just asked (FW-4013);
 * that became a `GapCell` `notSet`, because it is not a task of ours that
 * happens to be visible — it is a fact somebody standing in the car park wants
 * and nobody had published.
 *
 * CJ supplied the policy on 2026-09-03, so it is now a plain answer. That is the
 * whole point of marking a gap rather than guessing at one: the mark comes off
 * cleanly when the fact arrives, and nothing wrong was ever published meanwhile.
 *
 * The same gap was mirrored on /policy and has been closed there in the same
 * pass — the rule now sits in that page's `rules` list. Keep the two in step.
 *
 * The `gap` field below stays in the type and in the renderer: it is the general
 * mechanism, not a one-off for this row.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/venue/BookButton.astro';
import GapCell from '../components/venue/GapCell.astro';
import { getVenues, summariseHours } from '../lib/venues';

const venues = await getVenues();

const metadata = {
  metaTitle: 'Book a Bay — Indoor Golf in Lakeville & Stillwater, MN',
  metaDescription:
    'Book a GolfZon bay at The Links. $35 an hour per bay, up to six players, clubs available. Choose Lakeville or Stillwater.',
};

/**
 * The questions people actually ask before booking. The cancellation window is
 * the top pre-booking objection in the segment and is almost never answered.
 *
 * A question we cannot answer carries a `gap` instead of an `a`, and the row
 * draws a `GapCell` in the answer slot. Never put a sentinel string ("TBC",
 * "STUB", "—") in `a`: that is the flat-page behaviour the gap system replaces.
 */
const beforeYouBook: { q: string; a?: string; gap?: { label: string; reason: string } }[] = [
  { q: 'What it costs', a: '$35 an hour, per bay — not per person. Through 30 September 2026.' },
  { q: 'How many fit', a: 'Up to six people in a bay comfortably.' },
  {
    q: 'Clubs',
    a: 'Rental sets are $15 at Lakeville. Left-handed players are covered — five of the six Lakeville bays play both ways.',
  },
  { q: 'Never played', a: 'Fine. Put it on easy, nobody is waiting behind you, and the simulator does the scoring.' },
  {
    q: 'Walk-ins',
    a: 'Walk-ins are welcome, but not guaranteed to have a spot. Reserve a bay if you would rather not risk the drive, or ring ahead and ask what is free.',
  },
  {
    q: 'Cancelling',
    a: 'Free if you cancel at least 48 hours ahead. Inside 48 hours you may be charged for the full bay. Cancel in Whoosh, the same place you booked.',
  },
];
---

<BaseLayout metadata={metadata}>
  <section class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg">
    <h1 class="text-4xl font-bold lg:text-5xl">Book a bay</h1>
    <p class="mt-4 max-w-2xl text-lg text-inkMuted">
      Pick a venue. Booking opens in Whoosh, our reservation system — you will finish there.
    </p>

    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {
        venues.map((venue) => (
          <li class="rounded border-2 border-ink/15 p-6">
            <h2 class="text-2xl font-semibold">{venue.data.name}</h2>
            <p class="mt-1 text-sm text-inkMuted">
              {venue.data.streetAddress}, {venue.data.addressLocality}
            </p>
            <p class="mt-3 text-sm text-inkMuted">{summariseHours(venue).join(' · ')}</p>
            <p class="mt-3 text-sm text-inkMuted">
              {venue.data.bays} bays · {venue.data.simulator}
            </p>
            <div class="mt-6">
              <BookButton venue={venue} size="md" />
            </div>
          </li>
        ))
      }
    </ul>

    <section class="mt-section">
      <h2 class="text-2xl font-bold">Before you book</h2>
      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        {
          beforeYouBook.map(({ q, a, gap }) => (
            <div>
              <dt class="font-semibold">{q}</dt>
              <dd class="mt-1 text-inkMuted">
                {gap ? <GapCell label={gap.label} state="notSet" size="text" reason={gap.reason} /> : a}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </section>
</BaseLayout>
