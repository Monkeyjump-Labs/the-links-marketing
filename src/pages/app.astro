---
/**
 * The app's own page: one screen whose entire job is letting a visitor pick
 * their store.
 *
 * ── WHY THIS EXISTS ────────────────────────────────────────────────────────
 *
 * The banner's Download control server-rendered to Apple and was rewritten to
 * Google Play by a user-agent sniff. That is correct for a phone the sniff
 * recognises and wrong for everything else — a desktop visitor, an Android
 * browser spoofing its UA, anyone with JS off. The failure was silent and it
 * always failed the same direction: toward Apple. Owner reported it 2026-09-18.
 *
 * So the sniff stops being the answer and becomes an optimisation. This page is
 * the ground truth, the banner points here by default, and the sniff only ever
 * SHORTCUTS a visitor it is confident about. When it is wrong now, the visitor
 * lands on a choice instead of the wrong store.
 *
 * ── THE TWO BUTTONS ARE DELIBERATELY EQUAL ─────────────────────────────────
 *
 * Same size, same variant, same order every render. This page has exactly one
 * job and no opinion about which store the visitor wants; a "recommended" store
 * on a page reached BECAUSE the guess was wrong would be the same defect again.
 *
 * ── WHAT IS MARKED, AND WHY IT IS A GAP AND NOT A STUB ─────────────────────
 *
 * Two questions a visitor asks before spending a download: does it book a bay,
 * and does it work at Stillwater. Neither is published anywhere the venue
 * controls, and the second is sharpened by the listing being named "Lakeville
 * Links" — a Stillwater customer has an obvious reason to think it is not for
 * them. Those are customer-facing absences (`GapCell`), not build notes. What
 * WE owe — the feature list, the listing's name — is the `StubNote`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/venue/BookButton.astro';
import GapCell from '../components/venue/GapCell.astro';
import StubNote from '../components/venue/StubNote.astro';
import { buttonClasses } from '../lib/buttons';
import { APP_STORE_URL, PLAY_STORE_URL, APP_PITCH, APP_NAME, APP_LABEL } from '../lib/app';

const metadata = {
  metaTitle: `${APP_LABEL} — download for iPhone or Android`,
  metaDescription:
    'Download the app for The Links indoor golf, Lakeville & Stillwater MN. Available on the Apple App Store and Google Play.',
};

/**
 * One array, two buttons. Written once so the pair cannot drift apart — the
 * moment they are two hand-written blocks, one of them gets a tweak the other
 * does not and the page quietly starts favouring a store.
 */
const stores = [
  {
    name: 'App Store',
    device: 'iPhone and iPad',
    href: APP_STORE_URL,
    analytics: 'app-page-apple',
  },
  {
    name: 'Google Play',
    device: 'Android phones and tablets',
    href: PLAY_STORE_URL,
    analytics: 'app-page-google',
  },
];
---

<BaseLayout metadata={metadata}>
  <section class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg">
    <h1 class="text-4xl font-bold lg:text-5xl">{APP_LABEL}</h1>
    <p class="mt-4 max-w-2xl text-lg text-inkMuted">{APP_PITCH}</p>

    {/* 1. The choice. This is the whole page; everything below it is support. */}
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        stores.map((store) => (
          <div class="flex flex-col border-hairline border-ink/15 bg-paper p-cell">
            <h2 class="text-2xl font-bold">{store.name}</h2>
            <p class="mt-s3 flex-1 text-inkMuted">For {store.device}.</p>
            <a
              href={store.href}
              target="_blank"
              rel="noopener"
              class={`${buttonClasses('lg', 'primary')} mt-6 self-start`}
              data-analytics={store.analytics}
            >
              Get it on {store.name}
              <span class="sr-only">(opens the store in a new tab)</span>
            </a>
          </div>
        ))
      }
    </div>

    {
      /* 2. The searchable name. A visitor who gives up on the buttons and
       searches their store for "The Links" finds nothing — the listing is
       named for the venue it launched at. Saying so here costs one line and
       saves that dead end. */
    }
    <p class="mt-8 max-w-prose-page text-inkMuted">
      In both stores the app is listed as <strong class="font-semibold text-ink">{APP_NAME}</strong> — the name it launched
      under. If you are searching rather than tapping through, that is the one to look for.
    </p>

    {/* 3. The two questions a download is decided on, neither of them published. */}
    <section class="mt-section">
      <h2 class="text-3xl font-bold">Before you download</h2>
      <p class="mt-3 max-w-prose-page text-inkMuted">
        Two things people reasonably ask about the app that we have not published an answer to. Rather than guess at
        either, here they are — and either venue will answer them on the phone, from the
        <a href="/contact/" class="font-semibold underline">contact page</a>.
      </p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <GapCell
          label="Booking a bay in the app"
          state="notSet"
          size="name"
          reason="Whether a bay can be booked in the app, or whether booking still goes through the website, is not stated in either store listing. The Book a Bay button on this site works either way."
        />
        <GapCell
          label="Stillwater"
          state="notSet"
          size="name"
          reason="The listing is named Lakeville Links and nothing published says whether it covers The Links of Stillwater. If you play at Stillwater, ask us before you rely on it."
        />
      </div>
      <StubNote
        class="mt-6"
        needs="Get the actual feature list from CJ — what the app does beyond leagues, events and promotions — and replace both gaps above with answers. Confirm whether it covers Stillwater or is Lakeville-only; that determines whether this page can be linked from the Stillwater location page. Confirm it is free on Google Play (Apple's listing was read as free on 2026-09-08; Google's was not checked for price, so no price claim is made on this page). Separately, worth raising with CJ: the stores list it as Lakeville Links while the brand is now The Links across two venues — renaming the listing is the client's call, not ours, and until it happens the searchable-name line above has to stay."
      />
    </section>

    {/* Every page ends in a transactional CTA (playbook-core.md §6). */}
    <section class="mt-section">
      <h2 class="text-2xl font-bold">You do not need the app to book</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        The app is for keeping up with leagues, events and promotions. If you came here to get a bay booked, that is two
        clicks from any page on this site and always has been.
      </p>
      <div class="mt-6">
        <BookButton size="lg" />
      </div>
    </section>
  </section>
</BaseLayout>
