---
/**
 * Rates AND hours on one page — the same decision moment. Splitting them is a
 * recurring audit failure (playbook-core.md §3).
 * Prices are HTML text, never an image. Seasonality is a field on this page,
 * never a second page (the /rates vs /rates-summer trap on the reference site).
 *
 * VOICE PASS 2026-08-04 (FW-4001). This was one of the four flattest pages on
 * the site: a heading, one line, and two tables. Nothing here changes a number,
 * a date or an eligibility rule — every figure still comes from `content/rates`
 * and `content/venues` and is rendered by the same two components. What changed
 * is that the page now says what the price MEANS ("six of you for the price of
 * one of you") before it shows the table, which is the thing a first-timer is
 * actually trying to work out and the one place this page can be warm without
 * touching a fact.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RatesTable from '../components/venue/RatesTable.astro';
import HoursTable from '../components/venue/HoursTable.astro';
import BookButton from '../components/venue/BookButton.astro';
import { getVenues } from '../lib/venues';

const venues = await getVenues();
const cards = (await getCollection('rates')).sort((a, b) => a.data.order - b.data.order);

const metadata = {
  metaTitle: 'Rates & Hours — Indoor Golf, Lakeville & Stillwater MN',
  metaDescription:
    'What an hour costs at The Links and when we are open. $35 per bay per hour through 30 September 2026. Full weekly hours for both Twin Cities venues.',
};
---

<BaseLayout metadata={metadata}>
  <section class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg">
    <h1 class="text-4xl font-bold lg:text-5xl">Rates &amp; hours</h1>
    <p class="mt-4 max-w-2xl text-lg text-inkMuted">
      A bay is priced by the hour, not by the person. Six of you costs the same as one of you, which is either a bargain
      or an obligation to invite people, depending on how you look at it.
    </p>
    <p class="mt-4 max-w-2xl text-inkMuted">
      You do not need a membership to book one. Reserve an hour, turn up, play. If you have never done this before, an
      hour is plenty, and nobody is going to rush you out of the bay.
    </p>

    {cards.map((card) => <RatesTable card={card} />)}

    <section class="mt-section">
      <h2 class="text-3xl font-bold">Hours</h2>
      <div class="mt-8 grid gap-10 md:grid-cols-2">
        {
          venues.map((venue) => (
            <div>
              <h3 class="text-xl font-semibold">{venue.data.name}</h3>
              <div class="mt-4">
                <HoursTable venue={venue} />
              </div>
              <div class="mt-6">
                <BookButton venue={venue} size="sm" variant="outline" />
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </section>
</BaseLayout>
