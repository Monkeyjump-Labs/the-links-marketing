---
/**
 * The retention lever. 41% of venues have no membership page at all
 * (playbook-sim-venue.md §4), and the spec for the ones that do is explicit:
 * tiers as cards with one marked recommended, and state what's included, hours
 * restrictions, guest policy, whether the member must be present, commitment
 * length, and how to cancel.
 *
 * Prices here are HTML text (playbook-core.md §8). On the current site every one
 * of these numbers lives inside a JPEG.
 *
 * ⚠️ The LinksFlex "Anytime" tier is deliberately NOT published as a buyable
 * card. At $39.56–$45.75 an hour effective it costs MORE than the $35 walk-up
 * rate, so selling it would be selling a worse deal to a loyal customer. That is
 * a repricing decision, not a copy fix (strategy.md §7.4).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/venue/BookButton.astro';
import { globalData } from '../data/global';

const metadata = {
  metaTitle: 'Golf Memberships & LinksFlex — Lakeville & Stillwater',
  metaDescription:
    'Monthly memberships and LinksFlex prepaid hours at The Links, Lakeville and Stillwater MN. Hours never expire. Compare tiers and join online.',
};

/** Monthly memberships. Both venues. Client-supplied figures. */
const monthly = [
  {
    name: 'Summer Monthly — Individual',
    price: '$149',
    cadence: 'a month',
    recommended: true,
    recommendedNote: 'Most people start here',
    forWho: 'One golfer who wants to play most weeks.',
    includes: [
      'Two hours of bay time every day',
      '21-day booking window — you book before everyone else',
      '10% off food and drink',
      'No guest fees',
      'Buy extra hours any time at the normal rate',
    ],
  },
  {
    name: 'Summer Monthly — Family',
    price: '$199',
    cadence: 'a month',
    recommended: false,
    forWho: 'The purchaser plus immediate family, sharing one membership.',
    includes: [
      'Two hours of bay time every day',
      '21-day booking window',
      '10% off food and drink',
      'No guest fees',
      'Usable by the purchaser and immediate family',
    ],
  },
];

/**
 * LinksFlex — prepaid hours that never expire. Lakeville only today.
 * The effective hourly figures are arithmetic on the client's own prices, not
 * new claims: they exist so a first-time buyer can see the saving without doing
 * long division in their head.
 */
const linksFlex = [
  {
    name: 'LinksFlex Off Peak',
    window: 'Monday to Friday 8am–5pm, and Sundays after 3pm',
    recommended: true,
    recommendedNote: 'Best value per hour',
    rows: [
      { hours: '12 hours', price: '$399', perHour: '$33.25 an hour' },
      { hours: '24 hours', price: '$749', perHour: '$31.21 an hour' },
      { hours: '48 hours', price: '$1,399', perHour: '$29.15 an hour' },
    ],
  },
  {
    name: 'LinksFlex Junior',
    window: 'Monday to Friday 2pm–5pm, for players aged 13 to 18',
    recommended: false,
    rows: [
      { hours: '12 hours', price: '$299', perHour: '$24.92 an hour' },
      { hours: '24 hours', price: '$549', perHour: '$22.88 an hour' },
      { hours: '48 hours', price: '$999', perHour: '$20.81 an hour' },
    ],
  },
];

/** The six questions the playbook says a membership page must answer. */
const smallPrint = [
  [
    'What you get',
    'Bay time, not lessons or league entry. Leagues and instruction are booked and paid for separately.',
  ],
  [
    'Hours restrictions',
    'The monthly memberships include two hours a day and are subject to opening hours — a membership does not guarantee a walk-in bay. LinksFlex Off Peak and Junior hours are limited to the windows above; there is no restriction on how long you take to use them.',
  ],
  ['Guests', 'No guest fees on either monthly tier. Guests play on your booking, in your bay.'],
  ['Do you have to be there?', 'Yes. The member has to be present at the tee time.'],
  [
    'Commitment',
    'The monthly memberships bill automatically each month until 3 October 2026, or until you cancel. LinksFlex is a one-off purchase with no monthly commitment — the hours never expire, but they are non-transferable and all sales are final.',
  ],
];
---

<BaseLayout metadata={metadata}>
  <section class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg">
    <h1 class="text-4xl font-bold lg:text-5xl">Memberships</h1>
    <p class="mt-4 max-w-2xl text-lg text-inkMuted">
      Two ways to pay less per hour: a monthly membership if you play most weeks, or a bank of prepaid LinksFlex hours
      that never expire if you play in bursts. You do not need to be any good at golf to be worth one.
    </p>

    {/* 1. Monthly tiers as cards, one marked recommended (playbook sim-venue.md §4). */}
    <section class="mt-section">
      <h2 class="text-3xl font-bold">Monthly membership</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        Available at both venues. Two hours of bay time a day, every day, plus the booking window that gets you the
        Saturday slot before anyone else asks for it.
      </p>

      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        {
          monthly.map((tier) => (
            <li
              class:list={[
                'relative flex flex-col rounded border-2 p-6',
                tier.recommended ? 'border-primary' : 'border-ink/15',
              ]}
            >
              {tier.recommended && (
                <span class="absolute -top-3 left-6 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-surface">
                  {tier.recommendedNote}
                </span>
              )}
              <h3 class="text-xl font-semibold">{tier.name}</h3>
              <p class="mt-3">
                <span class="text-3xl font-bold">{tier.price}</span>
                <span class="text-inkMuted"> {tier.cadence}</span>
              </p>
              <p class="mt-3 text-inkMuted">{tier.forWho}</p>
              <ul class="mt-4 flex-1 list-disc space-y-1 pl-5 text-sm text-inkMuted">
                {tier.includes.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={globalData.external.membershipsLakeville}
          class="inline-block rounded bg-primary px-6 py-3 font-semibold text-surface transition hover:opacity-90"
          target="_blank"
          rel="noopener"
          data-analytics="membership:lakeville"
        >
          Join at Lakeville <span aria-hidden="true">→</span>
          <span class="sr-only">(opens the Whoosh store in a new tab)</span>
        </a>
        <a
          href={globalData.external.membershipsStillwater}
          class="inline-block rounded border-2 border-current px-6 py-3 font-semibold text-ink transition hover:bg-ink hover:text-surface"
          target="_blank"
          rel="noopener"
          data-analytics="membership:stillwater"
        >
          Join at Stillwater <span aria-hidden="true">→</span>
          <span class="sr-only">(opens the Whoosh store in a new tab)</span>
        </a>
      </div>

      <p class="mt-6 rounded border-2 border-dashed border-ink/25 p-4 text-sm text-inkMuted">
        <strong>STUB —</strong> these are the <em>summer</em> membership terms (May to September, renewing until 3 October
        2026). The winter equivalent has not been supplied, and winter is this venue's real season. Winter membership pricing,
        included hours and start date are needed before launch.
      </p>
    </section>

    {
      /* 2. LinksFlex. No peer in the competitive scan offers prepaid hours that
       never expire — it is the strongest differentiator on the site and is
       currently buried in a terms-and-conditions page (strategy.md §2). */
    }
    <section class="mt-section">
      <h2 class="text-3xl font-bold">LinksFlex — prepaid hours</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        Buy a block of hours up front, use them whenever. They do not expire, so a bad month costs you nothing. Cheaper
        per hour than walking in, and there is no monthly bill.
      </p>
      <p class="mt-3 max-w-2xl text-inkMuted">
        <strong>Lakeville only</strong> at the moment. Every LinksFlex block also carries the 21-day booking window and 10%
        off food and drink.
      </p>

      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {
          linksFlex.map((pack) => (
            <div class:list={['relative rounded border-2 p-6', pack.recommended ? 'border-primary' : 'border-ink/15']}>
              {pack.recommended && (
                <span class="absolute -top-3 left-6 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-surface">
                  {pack.recommendedNote}
                </span>
              )}
              <h3 class="text-xl font-semibold">{pack.name}</h3>
              <p class="mt-2 text-sm text-inkMuted">{pack.window}</p>
              <table class="mt-4 w-full text-left text-sm">
                <caption class="sr-only">{pack.name} prices</caption>
                <thead>
                  <tr class="border-b-2 border-ink/20">
                    <th scope="col" class="py-2 pr-4">
                      Block
                    </th>
                    <th scope="col" class="py-2 pr-4">
                      Price
                    </th>
                    <th scope="col" class="py-2">
                      Works out at
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {pack.rows.map((row) => (
                    <tr class="border-b border-ink/10 last:border-0">
                      <th scope="row" class="py-3 pr-4 font-medium">
                        {row.hours}
                      </th>
                      <td class="py-3 pr-4 font-semibold">{row.price}</td>
                      <td class="py-3 text-inkMuted">{row.perHour}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))
        }
      </div>

      <a
        href={globalData.external.membershipsLakeville}
        class="mt-8 inline-block rounded bg-primary px-6 py-3 font-semibold text-surface transition hover:opacity-90"
        target="_blank"
        rel="noopener"
        data-analytics="linksflex:lakeville"
      >
        Buy a LinksFlex block <span aria-hidden="true">→</span>
        <span class="sr-only">(opens the Whoosh store in a new tab)</span>
      </a>

      {/* The Anytime tier, held back on purpose. See the file header. */}
      <div class="mt-8 rounded border-2 border-dashed border-ink/25 p-6">
        <h3 class="text-lg font-semibold">
          <span class="text-inkMuted">STUB —</span> LinksFlex Anytime is not published
        </h3>
        <p class="mt-3 text-sm text-inkMuted">
          A third block, "LinksFlex Anytime" (no day or time restriction), is priced at $549 / $1,049 / $1,899 for 12 /
          24 / 48 hours. That works out at $45.75, $43.71 and $39.56 an hour — <strong
            >more than the $35 walk-up rate</strong
          >. A premium tier that costs more than simply turning up is not something we will sell, so it is held back.
        </p>
        <p class="mt-3 text-sm text-inkMuted">
          <strong>Needed from the client:</strong> a repriced Anytime tier, or a decision to retire it. This is a pricing
          call, not a wording one.
        </p>
      </div>

      <p class="mt-6 rounded border-2 border-dashed border-ink/25 p-4 text-sm text-inkMuted">
        <strong>STUB —</strong> two open questions on LinksFlex. (1) Whether the hour banks can be used at Stillwater, or
        stay Lakeville-only. (2) The Off Peak window starts at 8am and the Junior window at 2pm, but Lakeville currently opens
        at 11am — either the windows were written for winter hours or the published hours are wrong.
      </p>
    </section>

    {/* 3. The small print the playbook requires, in plain words. */}
    <section class="mt-section">
      <h2 class="text-3xl font-bold">Before you join</h2>
      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        {
          smallPrint.map(([q, a]) => (
            <div>
              <dt class="font-semibold">{q}</dt>
              <dd class="mt-1 text-inkMuted">{a}</dd>
            </div>
          ))
        }
        <div>
          <dt class="font-semibold">How to cancel</dt>
          <dd class="mt-1 text-inkMuted">
            <span class="font-semibold text-ink">STUB —</span> the cancellation mechanism and notice period for a monthly
            membership have not been supplied. "Automatic monthly renewal until cancelled" is the only language that exists
            today, and it does not tell anyone how to cancel. Needed from the client before launch.
          </dd>
        </div>
      </dl>
    </section>

    {/* Every page ends in a transactional CTA (playbook-core.md §6). */}
    <section class="mt-section rounded bg-surface p-8">
      <h2 class="text-2xl font-bold">Not sure yet?</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        Book one hour at the normal rate first. If you come back twice more this month, the membership has already paid
        for itself.
      </p>
      <div class="mt-6"><BookButton size="lg" /></div>
    </section>
  </section>
</BaseLayout>
