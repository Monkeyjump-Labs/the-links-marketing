        <HoursTable venue={demoVenue} />
      </div>

      <h3 class="mt-10 text-lg font-bold" style={`color: ${navy};`}>WaitlistForm</h3>
      <p class="mt-1 max-w-prose-page text-sm" style={`color: ${inkMuted};`}>
        Degrades to a <code>mailto:</code> when <code>PUBLIC_LEAD_ENDPOINT</code> is unset, and says so rather than dropping
        the lead.
      </p>
      <div class="mt-4 max-w-2xl">
        <WaitlistForm listName="styleguide" heading="Join the list" />
      </div>

      <h3 class="mt-10 text-lg font-bold" style={`color: ${navy};`}>LeagueCard — all three registration states</h3>
      <p class="mt-1 max-w-prose-page text-sm" style={`color: ${inkMuted};`}>
        One real league entry with <code>state</code> swapped, so the three are honestly comparable. No state is a dead end:
        <code>open</code> registers, <code>full</code> and <code>between</code> both fall through to the waitlist.
      </p>
      <div class="mt-4 grid gap-8 lg:grid-cols-2">
        {
          demoLeagues.map((demo) => (
            <div>
              <p class="mb-2 font-mono text-xs" style={`color: ${ember};`}>
                {demo.label}
              </p>
              <LeagueCard league={demo.entry} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── 7. Motion, z-index, breakpoints ────────────────────────────────── -->
    <section id="spec" class="mt-16" style="font-family: var(--brand-font-body);">
      <h2
        class="font-extrabold"
        style={`font-size: ${value('typeScale.displayRow')}; line-height: ${value('lineHeight.display')}; letter-spacing: ${value('tracking.displayNormal')}; color: ${navy}; font-family: var(--brand-font-display);`}
      >
        Motion, z-index, breakpoints
      </h2>

      <h3 class="mt-8 text-lg font-bold" style={`color: ${navy};`}>Motion</h3>
      <p class="mt-2 max-w-prose-page text-sm" style={`color: ${inkMuted};`}>{groupDescription('motion')}</p>
      <table class="mt-4 w-full text-left text-sm">
        <thead>
          <tr class="border-b-2" style={`border-color: ${navy};`}>
            <th scope="col" class="py-2 pr-4">Token</th>
            <th scope="col" class="py-2 pr-4">Value</th>
            <th scope="col" class="py-2">Use</th>
          </tr>
        </thead>
        <tbody>
          {
            group('motion.duration').map((row) => (
              <tr class="border-b" style={`border-color: ${greige};`}>
                <td class="py-2 pr-4 font-mono text-xs">motion.duration.{row.name}</td>
                <td class="py-2 pr-4 font-mono text-xs">{row.resolved}</td>
                <td class="py-2" style={`color: ${inkMuted};`}>
                  {row.$description}
                </td>
              </tr>
            ))
          }
          {
            group('motion.easing').map((row) => (
              <tr class="border-b" style={`border-color: ${greige};`}>
                <td class="py-2 pr-4 font-mono text-xs">motion.easing.{row.name}</td>
                <td class="py-2 pr-4 font-mono text-xs">cubic-bezier({row.resolved})</td>
                <td class="py-2" style={`color: ${inkMuted};`}>
                  {row.$description ?? '—'}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h3 class="mt-10 text-lg font-bold" style={`color: ${navy};`}>z-index</h3>
      <table class="mt-4 w-full text-left text-sm">
        <thead>
          <tr class="border-b-2" style={`border-color: ${navy};`}>
            <th scope="col" class="py-2 pr-4">Token</th>
            <th scope="col" class="py-2 pr-4">Value</th>
            <th scope="col" class="py-2 pr-4">Tailwind utility</th>
            <th scope="col" class="py-2">Use</th>
          </tr>
        </thead>
        <tbody>
          {
            group('zIndex').map((row) => (
              <tr class="border-b" style={`border-color: ${greige};`}>
                <td class="py-2 pr-4 font-mono text-xs">zIndex.{row.name}</td>
                <td class="py-2 pr-4 font-mono text-xs">{row.resolved}</td>
                <td class="py-2 pr-4 font-mono text-xs">z-{row.name.toLowerCase()}</td>
                <td class="py-2" style={`color: ${inkMuted};`}>
                  {row.$description ?? '—'}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <h3 class="mt-10 text-lg font-bold" style={`color: ${navy};`}>Breakpoints</h3>
      <p class="mt-2 max-w-prose-page text-sm" style={`color: ${inkMuted};`}>{groupDescription('breakpoint')}</p>
      <table class="mt-4 w-full text-left text-sm">
        <thead>
          <tr class="border-b-2" style={`border-color: ${navy};`}>
            <th scope="col" class="py-2 pr-4">Token</th>
            <th scope="col" class="py-2 pr-4">Min width</th>
            <th scope="col" class="py-2">What changes</th>
          </tr>
        </thead>
        <tbody>
          {
            group('breakpoint').map((row) => (
              <tr class="border-b" style={`border-color: ${greige};`}>
                <td class="py-2 pr-4 font-mono text-xs">breakpoint.{row.name}</td>
                <td class="py-2 pr-4 font-mono text-xs">{row.resolved}</td>
                <td class="py-2" style={`color: ${inkMuted};`}>
                  {row.$description}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-3 max-w-prose-page text-sm" style={`color: ${inkMuted};`}>
        These are token values, not Tailwind's breakpoints. Custom properties cannot be used inside
        <code>@media</code>, so <code>sm:</code>, <code>md:</code>, <code>lg:</code> and <code>xl:</code> in the markup still
        resolve to Tailwind's own defaults (640/768/1024/1280px). Keeping the two in sync is a manual job the compiler flags
        in a comment at the foot of <code>tokens.css</code>.
      </p>
    </section>

    <!-- ── 8. Pending implementation ──────────────────────────────────────── -->
    <section id="pending" class="mt-16" style="font-family: var(--brand-font-body);">
      <div class="border-4 p-6 lg:p-10" style={`border-color: ${ember};`}>
        <h2
          class="font-extrabold"
          style={`font-size: ${value('typeScale.displayRow')}; line-height: ${value('lineHeight.display')}; letter-spacing: ${value('tracking.displayNormal')}; color: ${navy}; font-family: var(--brand-font-display);`}
        >
          Pending implementation
        </h2>
        <p class="mt-2 max-w-prose-page text-sm" style={`color: ${inkMuted};`}>
          Straight from <code>notes.pendingImplementation</code>. {groupDescription('notes.pendingImplementation')}
        </p>
        <ul class="mt-6 space-y-5">
          {
            pendingImplementation().map((note) => (
              <li class="border-l-4 pl-4" style={`border-color: ${value('semantic.state.warning')};`}>
                <p class="font-mono text-sm font-bold" style={`color: ${ember};`}>
                  {note.name}
                </p>
                <p
                  class="mt-1 max-w-prose-page text-sm"
                  style={`color: ${value('semantic.ink.bodyOnLight')}; line-height: ${value('lineHeight.body')};`}
                >
                  {note.text}
                </p>
              </li>
            ))
          }
          <li class="border-l-4 pl-4" style={`border-color: ${value('semantic.state.warning')};`}>
            <p class="font-mono text-sm font-bold" style={`color: ${ember};`}>bodyFaceAlsoNotWired</p>
            <p
              class="mt-1 max-w-prose-page text-sm"
              style={`color: ${value('semantic.ink.bodyOnLight')}; line-height: ${value('lineHeight.body')};`}
            >
              Not in the token file, found while building this page: the repository declares no <code>@font-face</code>
              at all. <code>public/fonts/open-sans-*.woff2</code> ships but nothing references it, so
              <code>font.body</code> is falling back too — not just <code>font.display</code>.
            </p>
          </li>
          <li class="border-l-4 pl-4" style={`border-color: ${value('semantic.state.warning')};`}>
            <p class="font-mono text-sm font-bold" style={`color: ${ember};`}>typeScalePairingUndeclared</p>
            <p
              class="mt-1 max-w-prose-page text-sm"
              style={`color: ${value('semantic.ink.bodyOnLight')}; line-height: ${value('lineHeight.body')};`}
            >
              <code>typeScale</code>, <code>tracking</code> and <code>lineHeight</code> are three independent scales with
              no declared binding between them. Until one exists, every surface picks its own pairing and the type section
              above has to infer one from token names.
            </p>
          </li>
        </ul>

        <div class="mt-8 border-t-2 pt-6" style={`border-color: ${greige};`}>
          <p
            class="text-sm"
            style={`color: ${value('semantic.ink.bodyOnLight')}; line-height: ${value('lineHeight.body')};`}
          >
            <strong>Changing a token.</strong> Edit
            <code>marketing/websites/the-links/design/tokens.json</code>, run <code>npm run tokens:build</code>, and
            commit both files. <code>src/styles/tokens.css</code> is generated — never hand-edit it.
            <code>npm run tokens:check</code> fails the build if it is stale, and re-measures
            {' '}every gated pairing so a palette tweak cannot quietly ship a 3.2:1 button. The prose companion to this
            page is <code>marketing/websites/the-links/design/STYLE-GUIDE.md</code>.
          </p>
        </div>
      </div>
    </section>

    <!-- Referenced so the specimen palette is obviously live, not decorative. -->
    <p class="mt-12 text-xs" style={`color: ${inkMuted};`}>
      Rendered from tokens.json v{meta.version} ({meta.date}). Ground vocabulary in use on this page:
      <span style={`color: ${navy};`}>navy</span>, <span style={`color: ${ember};`}>ember</span>,
      <span style={`background: ${midnight}; color: ${amber}; padding: 0 0.25rem;`}>amber on midnight</span>,
      <span style={`background: ${midnight}; color: ${screenLight}; padding: 0 0.25rem;`}>screenLight on midnight</span
      >.
    </p>
  </div>
</BaseLayout>
