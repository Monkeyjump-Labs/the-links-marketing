---
/**
 * /styleguide — the rendered design system.
 *
 * INTERNAL. `noIndex: true`, and astro.config.mjs keeps it out of the sitemap.
 *
 * Every swatch, scale row and spec table on this page is read from the canonical
 * DTCG file at marketing/websites/the-links/design/tokens.json via src/lib/tokens.ts.
 * Nothing here is a transcribed value, and every contrast ratio shown is measured
 * on the page with the WCAG 2.1 relative-luminance formula — the same one the
 * build gate in scripts/build-tokens.mjs uses. If a token changes, this page
 * changes with it; it cannot drift from the system.
 *
 * The components section renders the REAL components, not copies, so a styling
 * regression in src/components/venue/ shows up here.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/venue/BookButton.astro';
import WaitlistForm from '../components/venue/WaitlistForm.astro';
import LeagueCard from '../components/venue/LeagueCard.astro';
import HoursTable from '../components/venue/HoursTable.astro';
import TrustStrip from '../components/venue/TrustStrip.astro';
import { getVenues } from '../lib/venues';
import {
  meta,
  group,
  groupDescription,
  leaf,
  value,
  resolve,
  contrast,
  ratioText,
  verdict,
  luminance,
  remToPx,
  prohibitions,
  pendingImplementation,
  type TokenRow,
} from '../lib/tokens';

const metadata = {
  metaTitle: 'Design system & style guide',
  metaDescription:
    'Internal reference for The Links: every colour role, type step, space, border and component, rendered from the canonical token file with measured contrast ratios.',
  noIndex: true,
};

// ── Grounds ──────────────────────────────────────────────────────────────────
// Each semantic role is drawn on the ground its own $description names, so the
// ratio shown underneath is the ratio that role actually has to clear. A token
// that is only legal on dark is DISPLAYED on dark.

type SpecimenMode = 'ground' | 'text' | 'fill' | 'block' | 'rule';

interface RoleSpec {
  mode: SpecimenMode;
  /** Token path of the ground this role is legal on. */
  ground: string;
  /** Token path of the label ink, for `ground` and `fill` specimens. */
  ink?: string;
}

const SPEC: Record<string, RoleSpec> = {
  // Grounds render as fields, labelled in the ink that is legal on them.
  'semantic.ground.chrome': { mode: 'ground', ground: 'semantic.ground.chrome', ink: 'semantic.ink.onDark' },
  'semantic.ground.hero': { mode: 'ground', ground: 'semantic.ground.hero', ink: 'semantic.ink.onDarkStrong' },
  'semantic.ground.base': { mode: 'ground', ground: 'semantic.ground.base', ink: 'semantic.ink.bodyOnLight' },
  'semantic.ground.raised': { mode: 'ground', ground: 'semantic.ground.raised', ink: 'semantic.ink.bodyOnLight' },
  'semantic.ground.alt': { mode: 'ground', ground: 'semantic.ground.alt', ink: 'semantic.ink.bodyOnLight' },
  'semantic.ground.accentBand': {
    mode: 'ground',
    ground: 'semantic.ground.accentBand',
    ink: 'semantic.ink.onAccentBand',
  },
  'semantic.ground.rowHover': { mode: 'ground', ground: 'semantic.ground.rowHover', ink: 'semantic.ink.onDark' },
  'semantic.ground.media': { mode: 'ground', ground: 'semantic.ground.media', ink: 'semantic.media.slotLabel' },

  // Ink roles render as text on their stated ground.
  'semantic.ink.onDarkStrong': { mode: 'text', ground: 'palette.midnight' },
  'semantic.ink.onDark': { mode: 'text', ground: 'palette.midnight' },
  'semantic.ink.mutedOnDark': { mode: 'text', ground: 'palette.midnight' },
  'semantic.ink.displayOnLight': { mode: 'text', ground: 'palette.white' },
  'semantic.ink.bodyOnLight': { mode: 'text', ground: 'palette.white' },
  'semantic.ink.mutedOnLight': { mode: 'text', ground: 'palette.white' },
  'semantic.ink.onAccentBand': { mode: 'text', ground: 'palette.ember' },

  // Primary is a fill plus its label, so the ratio measured is fill vs label.
  'semantic.primary.default': { mode: 'fill', ground: 'palette.white', ink: 'semantic.primary.on' },
  'semantic.primary.hover': { mode: 'fill', ground: 'palette.white', ink: 'semantic.primary.on' },
  'semantic.primary.active': { mode: 'fill', ground: 'palette.white', ink: 'semantic.primary.on' },
  'semantic.primary.on': { mode: 'text', ground: 'palette.ember' },
  'semantic.primary.onDarkFill': {
    mode: 'fill',
    ground: 'palette.midnight',
    ink: 'semantic.primary.onDarkFillInk',
  },
  'semantic.primary.onDarkFillInk': { mode: 'text', ground: 'palette.amber' },
  'semantic.primary.onDarkFillHover': {
    mode: 'fill',
    ground: 'palette.midnight',
    ink: 'semantic.primary.onDarkFillInk',
  },

  'semantic.accent.highlight': { mode: 'text', ground: 'palette.midnight' },
  'semantic.accent.caution': { mode: 'text', ground: 'palette.white' },
  'semantic.accent.screen': { mode: 'block', ground: 'palette.midnight' },

  'semantic.rule.onDark': { mode: 'rule', ground: 'palette.midnight' },
  'semantic.rule.onDarkQuiet': { mode: 'rule', ground: 'palette.midnight' },
  'semantic.rule.onLight': { mode: 'rule', ground: 'palette.white' },
  'semantic.rule.onLightQuiet': { mode: 'rule', ground: 'palette.white' },
  'semantic.rule.onAccentBand': { mode: 'rule', ground: 'palette.ember' },
  'semantic.rule.scoreOnDark': { mode: 'rule', ground: 'palette.midnight' },
  'semantic.rule.scoreOnLight': { mode: 'rule', ground: 'palette.white' },

  'semantic.state.focus': { mode: 'rule', ground: 'palette.white' },
  'semantic.state.focusOnDark': { mode: 'rule', ground: 'palette.midnight' },
  'semantic.state.focusOnAccentBand': { mode: 'rule', ground: 'palette.ember' },
  'semantic.state.error': { mode: 'text', ground: 'palette.white' },
  'semantic.state.errorOnDark': { mode: 'text', ground: 'palette.midnight' },
  'semantic.state.warning': { mode: 'text', ground: 'palette.white' },
  'semantic.state.success': { mode: 'text', ground: 'palette.white' },
  'semantic.state.successOnDark': { mode: 'text', ground: 'palette.midnight' },
  'semantic.state.info': { mode: 'text', ground: 'palette.white' },
  'semantic.state.infoOnDark': { mode: 'text', ground: 'palette.midnight' },
  'semantic.state.disabledSurface': {
    mode: 'ground',
    ground: 'semantic.state.disabledSurface',
    ink: 'semantic.state.disabledInk',
  },
  'semantic.state.disabledInk': { mode: 'text', ground: 'semantic.state.disabledSurface' },

  'semantic.media.slotGround': { mode: 'ground', ground: 'semantic.media.slotGround', ink: 'semantic.media.slotLabel' },
  'semantic.media.slotScreen': { mode: 'block', ground: 'semantic.media.slotGround' },
  'semantic.media.slotFairway': { mode: 'block', ground: 'semantic.media.slotScreen' },
  'semantic.media.slotPendant': { mode: 'block', ground: 'semantic.media.slotGround' },
  'semantic.media.slotMass': { mode: 'block', ground: 'semantic.media.slotGround' },
  'semantic.media.slotFrame': { mode: 'rule', ground: 'semantic.media.slotGround' },
  'semantic.media.slotLabel': { mode: 'text', ground: 'semantic.media.slotGround' },
};

/** The pair whose ratio the specimen is demonstrating. */
function measured(row: TokenRow): { fg: string; bg: string; against: string } {
  const spec = SPEC[row.path];
  if (spec.mode === 'fill' || spec.mode === 'ground') {
    return { fg: value(spec.ink as string), bg: row.resolved, against: spec.ink as string };
  }
  return { fg: row.resolved, bg: value(spec.ground), against: spec.ground };
}

const COLOUR_GROUPS = [
  {
    path: 'semantic.ground',
    title: 'Ground',
    blurb: 'The fields a page is built out of. Everything else is measured against one of these.',
  },
  {
    path: 'semantic.ink',
    title: 'Ink',
    blurb: 'Text. Every entry names the ground it is legal on; none of them is an opacity of another.',
  },
  {
    path: 'semantic.primary',
    title: 'Primary',
    blurb: 'The action colour. Ember fill on light, amber fill on dark — the two are not interchangeable.',
  },
  { path: 'semantic.accent', title: 'Accent', blurb: 'Highlight, caution and the simulator projection.' },
  {
    path: 'semantic.rule',
    title: 'Rule',
    blurb: 'The grid is meant to be seen. Rules are a colour role, not a border default.',
  },
  {
    path: 'semantic.state',
    title: 'State',
    blurb: 'Focus, error, warning, success, info, disabled — each with a dark-ground twin where one is needed.',
  },
  {
    path: 'semantic.media',
    title: 'Media',
    blurb: 'The drawn media slot. There is no photography yet, so the slot is an honest reservation.',
  },
];

// ── Type ─────────────────────────────────────────────────────────────────────
// The token file declares typeScale, tracking and lineHeight as three INDEPENDENT
// scales — it does not bind a tracking or a line-height to a given step. The
// pairing below is inferred from the token names so the specimen renders at a
// plausible real size; it is flagged as inferred everywhere it is shown, and
// noted as a gap in the pending-work section.
const TYPE_PAIRING: Record<string, { lineHeight: string; tracking: string }> = {
  displayHero: { lineHeight: 'lineHeight.displayHero', tracking: 'tracking.displayTight' },
  displaySection: { lineHeight: 'lineHeight.display', tracking: 'tracking.displayTight' },
  displayRow: { lineHeight: 'lineHeight.display', tracking: 'tracking.displayNormal' },
  displayCard: { lineHeight: 'lineHeight.display', tracking: 'tracking.displayNormal' },
  scoreboardXl: { lineHeight: 'lineHeight.scoreboard', tracking: 'tracking.displayNormal' },
  scoreboardMd: { lineHeight: 'lineHeight.scoreboard', tracking: 'tracking.displayNormal' },
  bodyLead: { lineHeight: 'lineHeight.body', tracking: 'tracking.bodyNormal' },
  bodyBase: { lineHeight: 'lineHeight.body', tracking: 'tracking.bodyNormal' },
  bodySmall: { lineHeight: 'lineHeight.body', tracking: 'tracking.bodyNormal' },
  labelBase: { lineHeight: 'lineHeight.label', tracking: 'tracking.labelWide' },
  labelSmall: { lineHeight: 'lineHeight.label', tracking: 'tracking.labelWider' },
};

const DISPLAY_FAMILIES = new Set(['display', 'numeric']);
const fontRows = group('font').filter((row) => row.name !== 'retired');
const retiredFont = leaf('font.retired');

// ── The ink-opacity ladder, measured ─────────────────────────────────────────
// rules.noInkOpacityForText is the prohibition that most often gets broken by a
// well-meaning `text-ink/70`. It is worth SHOWING rather than asserting, so the
// ladder below is composited and measured here against the CURRENT ink.
const inkHex = value('semantic.ink.displayOnLight');
const whiteHex = value('palette.white');

function composite(hex: string, alpha: number, over: string): string {
  const a = hex.replace('#', '');
  const b = over.replace('#', '');
  const mix = [0, 2, 4].map((i) =>
    Math.round(alpha * parseInt(a.slice(i, i + 2), 16) + (1 - alpha) * parseInt(b.slice(i, i + 2), 16)),
  );
  return `#${mix.map((n) => n.toString(16).padStart(2, '0')).join('')}`;
}

const inkLadder = [90, 80, 70, 65, 60, 50, 40].map((pct) => {
  const hex = composite(inkHex, pct / 100, whiteHex).toUpperCase();
  return { pct, hex, ratio: ratioText(hex, whiteHex), passes: contrast(hex, whiteHex) >= 4.5 };
});

// ── Live component data ──────────────────────────────────────────────────────
const venues = await getVenues();
const demoVenue = venues[0];

// Real league entries, with the registration state swapped so all three render.
// The component and the schema are real; only `state` and the state-specific
// copy differ, so the three cards are honestly comparable.
const leagues = (await getCollection('leagues')).sort((a, b) => a.data.order - b.data.order);
const baseLeague = leagues[0];
const leagueStates = [
  { state: 'open' as const, label: 'state: open — registers offsite' },
  { state: 'full' as const, label: 'state: full — waitlist' },
  { state: 'between' as const, label: 'state: between — notify me' },
];
const demoLeagues = leagueStates.map(({ state, label }) => ({
  label,
  entry: {
    ...baseLeague,
    id: `${baseLeague.id}--styleguide-${state}`,
    data: { ...baseLeague.data, state },
  },
}));

const controlHeights = ['size.controlSm', 'size.controlMd', 'size.controlLg'].map((path) => ({
  path,
  height: value(path),
}));

const sectionIndex = [
  ['colour', 'Colour'],
  ['prohibitions', 'Prohibitions'],
  ['type', 'Type'],
  ['space', 'Space'],
  ['structure', 'Border, radius, elevation'],
  ['components', 'Components'],
  ['spec', 'Motion, z-index, breakpoints'],
  ['pending', 'Pending implementation'],
];

const midnight = value('palette.midnight');
const paper = value('palette.paper');
const amber = value('palette.amber');
const ember = value('palette.ember');
const navy = value('palette.navy');
const inkMuted = value('semantic.ink.mutedOnLight');
const slate = value('palette.slate');
const greige = value('palette.greige');
const screenLight = value('palette.screenLight');
---

<BaseLayout metadata={metadata}>
  <div class="mx-auto max-w-content px-gutter py-section">
    <!-- ── Masthead ───────────────────────────────────────────────────────── -->
    <header class="border-b-4 pb-8" style={`border-color: ${ember}; font-family: var(--brand-font-display);`}>
      <p
        class="text-xs font-semibold uppercase"
        style={`letter-spacing: ${value('tracking.labelWider')}; color: ${inkMuted};`}
      >
        Internal · not indexed
      </p>
      <h1
        class="mt-4 font-extrabold"
        style={`font-size: ${value('typeScale.displaySection')}; line-height: ${value('lineHeight.display')}; letter-spacing: ${value('tracking.displayTight')}; color: ${navy};`}
      >
        {meta.brand} — design system
      </h1>
      <p
        class="mt-4 max-w-prose-page"
        style={`font-size: ${value('typeScale.bodyLead')}; line-height: ${value('lineHeight.body')}; color: ${value('semantic.ink.bodyOnLight')}; font-family: var(--brand-font-body);`}
      >
        Register: <strong>{meta.register}</strong>. Everything below is rendered from
        <code>marketing/websites/the-links/design/tokens.json</code> — the swatches, the scales, the spec tables and every
        contrast ratio. The ratios are measured on this page with the WCAG 2.1 relative-luminance formula, not copied out
        of the file, so a value that drifts shows up here as a number that disagrees with its own note.
      </p>

      <dl class="mt-6 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2" style="font-family: var(--brand-font-body);">
        {
          [
            ['Version', `${meta.version} · ${meta.date}`],
            ['Venues', meta.venues.join(' · ')],
            ['Status', meta.status],
            ['Contrast policy', meta.contrastPolicy],
            ['Compiled to', meta.compiledTo],
            ['Provenance', meta.provenance],
          ].map(([term, def]) => (
            <div class="flex gap-3">
              <dt class="shrink-0 font-semibold" style={`color: ${navy};`}>
                {term}
              </dt>
              <dd style={`color: ${inkMuted};`}>{def}</dd>
            </div>
          ))
        }
      </dl>

      <nav
        aria-label="Sections"
        class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm"
        style="font-family: var(--brand-font-body);"
      >
        {
          sectionIndex.map(([id, label]) => (
            <a href={`#${id}`} class="font-semibold underline" style={`color: ${value('semantic.ink.bodyOnLight')};`}>
              {label}
            </a>
          ))
        }
      </nav>
    </header>

    <!-- ── 1. Colour ──────────────────────────────────────────────────────── -->
    <section id="colour" class="mt-16" style="font-family: var(--brand-font-body);">
      <h2
        class="font-extrabold"
        style={`font-size: ${value('typeScale.displayRow')}; line-height: ${value('lineHeight.display')}; letter-spacing: ${value('tracking.displayNormal')}; color: ${navy}; font-family: var(--brand-font-display);`}
      >
        Colour
      </h2>

      <h3 class="mt-8 text-lg font-bold" style={`color: ${navy};`}>Palette primitives</h3>
      <p class="mt-2 max-w-prose-page text-sm" style={`color: ${inkMuted};`}>{groupDescription('palette')}</p>

      <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          group('palette').map((row) => (
            <li class="border-2" style={`border-color: ${greige};`}>
              <div class="h-20" style={`background: ${row.resolved};`} />
              <div class="p-4">
                <p class="font-mono text-sm font-bold" style={`color: ${navy};`}>
                  palette.{row.name}
                </p>
                <p class="mt-1 font-mono text-xs" style={`color: ${inkMuted};`}>
                  {row.resolved.toUpperCase()} · relative luminance {luminance(row.resolved).toFixed(4)}
                </p>
                <p
                  class="mt-2 text-xs"
                  style={`color: ${value('semantic.ink.bodyOnLight')}; line-height: ${value('lineHeight.body')};`}
                >
                  {row.$description}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-10 text-lg font-bold" style={`color: ${navy};`}>Retired primitives</h3>
      <p class="mt-2 max-w-prose-page text-sm" style={`color: ${inkMuted};`}>
        {groupDescription('palette.retired')} They are shown so a value that turns up in old CSS can be identified, never
        so it can be reused.
      </p>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          group('palette.retired').map((row) => (
            <li class="flex gap-3 border-2 p-3" style={`border-color: ${greige}; opacity: 0.85;`}>
              <span class="mt-0.5 h-10 w-10 shrink-0" style={`background: ${row.resolved};`} />
              <div>
                <p class="font-mono text-xs font-bold line-through" style={`color: ${inkMuted};`}>
                  palette.retired.{row.name}
                </p>
                <p class="font-mono text-xs" style={`color: ${inkMuted};`}>
                  {row.resolved.toUpperCase()}
                </p>
                <p class="mt-1 text-xs" style={`color: ${inkMuted};`}>
                  {row.$description}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-12 text-lg font-bold" style={`color: ${navy};`}>Semantic roles</h3>
      <p class="mt-2 max-w-prose-page text-sm" style={`color: ${inkMuted};`}>
        {groupDescription('semantic')} These are the names a component types. Each specimen is drawn on the ground its own
        note names, so a dark-only token is shown on dark — and the ratio under it is the ratio that role actually has to
        clear.
      </p>

      {
        COLOUR_GROUPS.map((section) => (
          <div class="mt-10">
            <h4 class="font-mono text-sm font-bold" style={`color: ${ember};`}>
              {section.path}
            </h4>
            <p class="mt-1 max-w-prose-page text-sm" style={`color: ${inkMuted};`}>
              {section.blurb}
            </p>

            <ul class="mt-4 divide-y-2" style={`border-color: ${greige};`}>
              {group(section.path).map((row) => {
                const spec = SPEC[row.path];
                const pair = measured(row);
                const groundHex = value(spec.ground);
                const r = contrast(pair.fg, pair.bg);
                const v = verdict(pair.fg, pair.bg);
                return (
                  <li class="grid gap-4 border-t-2 py-4 lg:grid-cols-[18rem_1fr]" style={`border-color: ${greige};`}>
                    <div>
                      {spec.mode === 'ground' && (
                        <div
                          class="flex h-24 items-end p-3"
                          style={`background: ${row.resolved}; color: ${value(spec.ink as string)};`}
                        >
                          <span class="font-mono text-xs">{spec.ink}</span>
                        </div>
                      )}
                      {spec.mode === 'text' && (
                        <div class="h-24 p-3" style={`background: ${groundHex};`}>
                          <p class="text-lg font-bold" style={`color: ${row.resolved};`}>
                            Tuesday is a golf night
                          </p>
                          <p
                            class="mt-1"
                            style={`color: ${row.resolved}; font-size: ${value('typeScale.bodySmall')}; line-height: ${value('lineHeight.body')};`}
                          >
                            Body copy at typeScale.bodySmall.
                          </p>
                        </div>
                      )}
                      {spec.mode === 'fill' && (
                        <div class="flex h-24 items-center justify-center p-3" style={`background: ${groundHex};`}>
                          <span
                            class="px-6 py-3 text-sm font-bold"
                            style={`background: ${row.resolved}; color: ${value(spec.ink as string)}; border-radius: ${value('radius.control')};`}
                          >
                            Book a Bay
                          </span>
                        </div>
                      )}
                      {spec.mode === 'block' && (
                        <div class="flex h-24 items-center justify-center p-3" style={`background: ${groundHex};`}>
                          <span class="block h-12 w-full" style={`background: ${row.resolved};`} />
                        </div>
                      )}
                      {spec.mode === 'rule' && (
                        <div class="flex h-24 flex-col justify-center gap-3 p-3" style={`background: ${groundHex};`}>
                          <span
                            class="block w-full"
                            style={`height: ${value('border.rule')}; background: ${row.resolved};`}
                          />
                          <span
                            class="block w-full"
                            style={`height: ${value('border.score')}; background: ${row.resolved};`}
                          />
                          <span
                            class="block w-full"
                            style={`height: ${value('border.slab')}; background: ${row.resolved};`}
                          />
                        </div>
                      )}
                    </div>

                    <div>
                      <p class="font-mono text-sm font-bold" style={`color: ${navy};`}>
                        {row.path}
                      </p>
                      <p class="mt-1 font-mono text-xs" style={`color: ${inkMuted};`}>
                        {row.alias ?? '—'} → {row.resolved.toUpperCase()}
                      </p>
                      <p
                        class="mt-2 text-sm font-semibold"
                        style={`color: ${r >= 4.5 ? value('semantic.state.success') : r >= 3 ? value('semantic.state.warning') : value('semantic.state.error')};`}
                      >
                        {ratioText(pair.fg, pair.bg)} — {v}
                        <span class="font-normal" style={`color: ${inkMuted};`}>
                          {' '}
                          (measured against {pair.against})
                        </span>
                      </p>
                      {row.$description && (
                        <p
                          class="mt-2 max-w-prose-page text-sm"
                          style={`color: ${value('semantic.ink.bodyOnLight')}; line-height: ${value('lineHeight.body')};`}
                        >
                          {row.$description}
                        </p>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </section>

    <!-- ── 2. Prohibitions ────────────────────────────────────────────────── -->
    <section id="prohibitions" class="mt-16" style="font-family: var(--brand-font-body);">
      <div style={`background: ${midnight}; color: ${paper};`}>
        <div class="p-6 lg:p-10">
          <span class="block w-full" style={`height: ${value('border.score')}; background: ${amber};`}></span>
          <h2
            class="mt-6 font-extrabold"
            style={`font-size: ${value('typeScale.displayRow')}; line-height: ${value('lineHeight.display')}; letter-spacing: ${value('tracking.displayNormal')}; color: ${value('semantic.ink.onDarkStrong')}; font-family: var(--brand-font-display);`}
          >
            The prohibitions
          </h2>
          <p class="mt-3 max-w-prose-page" style={`color: ${paper}; line-height: ${value('lineHeight.body')};`}>
            {groupDescription('rules')}
          </p>

          <ul class="mt-8 grid gap-6 lg:grid-cols-2">
            {
              prohibitions().map((rule) => (
                <li class="border-l-4 pl-4" style={`border-color: ${amber};`}>
                  <p class="font-mono text-sm font-bold" style={`color: ${amber};`}>
                    {rule.name}
                  </p>
