---
/**
 * Legal shell. Deliberately minimal: this is a structure a lawyer fills in, not
 * boilerplate copied from another venue's site. Every substantive clause is a
 * marked stub.
 *
 * Live inputs that will shape it: GA4 (G-DTLFJD8KFF) and a Meta Pixel
 * (1200620627766874) are already running, there is no consent banner today, and
 * an SMS opt-in form is linked from the footer. Whether a consent banner is
 * required is an open client/legal question (strategy.md §6).
 *
 * ── THE PROVISIONAL NOTICE IS CUSTOMER-FACING ON PURPOSE (FW-4013) ──────────
 *
 * This page used to open with "STUB — this page is a structure, not a policy",
 * addressed to us, and each section carried its own "STUB — Needed: …" block.
 * All of it rendered in production. A visitor read our build notes.
 *
 * The obvious fix — wrap the lot in `StubNote` so production emits nothing — is
 * the WRONG one here, and it is worth saying why, because it looks right. On a
 * privacy policy the disclosure is doing real work: it tells a reader the
 * document has not been through a lawyer. Hide it and the site presents an
 * unreviewed policy as though it were a reviewed one. Silence is a stronger
 * claim than the stub was.
 *
 * So the disclosure STAYS in production, rewritten in the reader's language —
 * no "STUB", no "Needed:", no instruction addressed to ourselves — and the
 * internal to-do beside each section moves into `StubNote`, which renders on
 * staging only. The same information, sorted by who it is for.
 *
 * Register: plain and calm. The site's voice is warm and a little funny
 * (client-answers.md §14) and this is the one page where that would read as
 * flippant, so it does not go there.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/venue/BookButton.astro';
import StubNote from '../components/venue/StubNote.astro';

const metadata = {
  metaTitle: 'Privacy Policy — The Links, Lakeville & Stillwater MN',
  metaDescription:
    'How The Links of Lakeville and The Links of Stillwater, Minnesota handle the personal information you give us on this website and when you book.',
};

const sections = [
  [
    'What we collect',
    'Booking details go to Whoosh, our reservation system, and are covered by their terms as well as ours. This site adds analytics and, if you use one, whatever you type into a form.',
    'Needed: the full list — forms, analytics, advertising pixels, the SMS opt-in, and anything the gift-card and membership vendors collect on our behalf.',
  ],
  [
    'Analytics and advertising',
    'This site runs Google Analytics 4 and a Meta pixel. Both set cookies and both are used to understand how people find and use the site.',
    'Needed: a legal decision on whether a consent banner is required for a Minnesota business, and the retention period for each tool.',
  ],
  [
    'Marketing email and SMS',
    'If you join a waitlist or opt in to texts, we use that address or number for what you asked for and nothing else.',
    'Needed: the mailing-list provider, the SMS provider and short code, the opt-out mechanism, and confirmation the SMS opt-in form is still in use.',
  ],
  [
    'Who else sees it',
    'Our booking, payment, gift-card and email providers, each only for the part they run.',
    'Needed: the named list of processors and a link to each of their policies.',
  ],
  [
    'Your choices',
    'You can ask what we hold, ask us to correct it, and ask us to delete it.',
    'Needed: the contact route for a request, the response time, and any state-law rights that apply.',
  ],
];
---

<BaseLayout metadata={metadata}>
  <section class="mx-auto max-w-prose-page px-gutter py-section lg:px-gutter-lg">
    <h1 class="text-4xl font-bold lg:text-5xl">Privacy policy</h1>
    <p class="mt-4 text-lg text-inkMuted">
      How The Links of Lakeville and The Links of Stillwater handle personal information.
    </p>

    {
      /* The provisional notice. Production-visible, deliberately — see the head
        of this file. One short paragraph, no build language, and it ends in a
        way out for the reader rather than an instruction to us. */
    }
    <p class="mt-8 border-l-slab border-ink/25 bg-surface p-6 text-inkBody">
      <strong>This policy is provisional.</strong> It describes, as plainly as we can, what we actually do with your information
      today — but it has not been written or reviewed by a lawyer, and it is not the finished document. If anything here matters
      to a decision you are making, email us and we will answer it directly.
    </p>

    {
      sections.map(([title, plain, needed]) => (
        <section class="mt-12">
          <h2 class="text-2xl font-bold">{title}</h2>
          <p class="mt-3 text-inkMuted">{plain}</p>
          <StubNote class="mt-3" needs={needed} />
        </section>
      ))
    }

    <section class="mt-12">
      <h2 class="text-2xl font-bold">Contact</h2>
      <p class="mt-3 text-inkMuted">
        Questions about any of this go to <a href="mailto:info@lakevillelinks.com" class="underline">
          info@lakevillelinks.com
        </a>.
      </p>
      <StubNote
        class="mt-3"
        needs="The registered address, and reconciliation of the entity name. CJ confirmed 2026-09-02 that Stillwater's registered name is 'URN 8 LLC dba The Links of Stillwater'. Lakeville's own name is still unresolved — two different entities ('Head Honchos, LLC dba Lakeville Links' and 'UDBA 10 dba The Links of Lakeville') appear across the current legal pages, and CJ was not asked about that conflict yet."
      />
    </section>

    {/* Every page ends in a transactional CTA (playbook-core.md §6). */}
    <section class="mt-section rounded bg-surface p-8">
      <h2 class="text-2xl font-bold">Book a bay</h2>
      <p class="mt-3 text-inkMuted">$35 an hour per bay, up to six of you, in Lakeville or Stillwater.</p>
      <div class="mt-6"><BookButton size="lg" /></div>
    </section>
  </section>
</BaseLayout>
