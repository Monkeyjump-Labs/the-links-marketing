---
/**
 * The highest revenue-per-visit page in the segment. The playbook is blunt about
 * the order: "Lead with a lead-capture form — do not bury it under 1,500 words
 * of packages" (playbook-sim-venue.md §4). So the form is the first thing after
 * the h1, and the packages sit under it.
 *
 * The visitor here is usually a planner, not a golfer. They need a number they
 * can put in a calendar invite and a number they can put in a budget.
 *
 * Competitors publish capacity as a number — X-Golf Eden Prairie publishes "up
 * to 75 guests" and surfaces on the live query. The Links has a real number and
 * currently buries it (seo-map.md §1.3).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EnquiryForm from '../components/forms/EnquiryForm.astro';
import BookButton from '../components/venue/BookButton.astro';
import { getVenues } from '../lib/venues';

const venues = await getVenues();

const metadata = {
  metaTitle: 'Golf Simulator Parties & Corporate Events — Twin Cities',
  metaDescription:
    'Corporate outings, birthdays and bachelor parties on golf simulators in Lakeville and Stillwater, MN. Capacity, packages and an inquiry form.',
};

/** The three recurring jobs the segment actually gets booked for. */
const jobs = [
  {
    title: 'Work outings and holiday parties',
    body: 'Nobody has to be good. Handicaps and easy settings mean the intern and the VP can be on the same team, and there is a bar in the room so the people who do not want to swing a club still have something to do.',
  },
  {
    title: 'Birthdays',
    body: 'Adult birthdays and teen ones. A bay is booked by the hour, not the head, so the cost does not climb every time someone else says yes.',
  },
  {
    title: 'Bachelor and bachelorette parties',
    body: 'A first stop that is warm, indoors, has food, and does not depend on the weather in Minnesota. Groups usually take two or three bays and rotate.',
  },
];

/** Facts the client has published and we can stand behind. */
const capacity = [
  [
    'Lakeville',
    '6 bays, room for up to 36 golfers across the venue. Each bay takes up to 6 people; 4 per bay is the pace we recommend.',
  ],
  [
    'Stillwater',
    'STUB — 4 bays. Total venue capacity, seating and whether the bowling alley side can be used for a larger group have not been supplied.',
  ],
];
---

<BaseLayout metadata={metadata}>
  <section class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg">
    <h1 class="text-4xl font-bold lg:text-5xl">Events &amp; parties</h1>
    <p class="mt-4 max-w-2xl text-lg text-inkMuted">
      Work outings, birthdays, bachelor parties and anything else that needs a room, a screen and a drink. Tell us the
      date and the headcount and we will come back with a price — that is the whole process.
    </p>

    {/* 1. The form. First, on purpose. */}
    <div class="mt-10 max-w-3xl">
      <EnquiryForm listName="event" id="enquiry" />
    </div>

    {/* 2. What people book it for. */}
    <section class="mt-section">
      <h2 class="text-3xl font-bold">What people book it for</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-3">
        {
          jobs.map((job) => (
            <li class="rounded border-2 border-ink/15 p-6">
              <h3 class="text-xl font-semibold">{job.title}</h3>
              <p class="mt-2 text-inkMuted">{job.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* 3. Capacity as a number. The competitor set publishes theirs. */}
    <section class="mt-section">
      <h2 class="text-3xl font-bold">How many people fit</h2>
      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        {
          capacity.map(([venue, detail]) => (
            <div>
              <dt class="font-semibold">{venue}</dt>
              <dd class="mt-1 text-inkMuted">{detail}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 max-w-2xl text-inkMuted">
        For timing, use one hour per person for 18 holes. A group of four in one bay takes roughly four hours. If that
        is longer than you want the event to run, book more bays and play fewer holes — most groups do.
      </p>
    </section>

    {/* 4. Packages. All pricing is unpublished; the structure ships, the numbers wait. */}
    <section class="mt-section">
      <h2 class="text-3xl font-bold">What it costs</h2>
      <div class="mt-6 rounded border-2 border-dashed border-ink/25 p-6">
        <p class="text-inkMuted">
          <strong>STUB —</strong> no event pricing has been supplied, and "group pricing applies for groups of 12 or more"
          is not a price. Competitors in the Twin Cities publish package prices and capacity numbers, and the planner comparing
          three venues on a Tuesday afternoon will not send an enquiry to the one that publishes neither.
        </p>
        <p class="mt-4 font-semibold">Needed from the client, before launch:</p>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-inkMuted">
          <li>A package price band — even "from $X per person" or two or three named packages</li>
          <li>Group discount thresholds: what "12 or more" actually saves you, and how it varies by day and season</li>
          <li>Minimum spend, deposit terms, and whether a deposit is refundable</li>
          <li>Full-venue buyout price, per venue</li>
          <li>What is included — bay time only, or food and drink packages too</li>
          <li>Catering options, and whether outside food or a cake is allowed</li>
          <li>Lead time: how far ahead a group of 20 needs to book</li>
          <li>Whether Stillwater takes events at all today, and who runs the food side</li>
        </ul>
      </div>
    </section>

    {/* 5. Food. Lakeville has its own kitchen; Stillwater's comes from its host. */}
    <section class="mt-section">
      <h2 class="text-3xl font-bold">Food and drink</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        Lakeville has a full bar and its own kitchen — pizza, wings, appetisers, and the tab runs through the venue so
        one person can settle it at the end. Stillwater's food and drink comes from Stillwater Bowl &amp; Lounge, the
        business the bays sit inside.
      </p>
      <a href="/menu/" class="mt-4 inline-block font-semibold underline">See the menu</a>
    </section>

    {/* 6. Photography. Real event photos are a spec requirement we cannot yet meet. */}
    <p class="mt-section rounded border-2 border-dashed border-ink/25 p-4 text-sm text-inkMuted">
      <strong>STUB —</strong> the playbook requires two or three photographs of an actual event on this page. None exist in
      the handover, and stock party imagery is a ship-blocker. A short shoot at the next corporate booking covers it.
    </p>

    {
      /* Every page ends in a transactional CTA. Here the enquiry is the conversion,
       so the secondary path is the small-group booking that needs no quote. */
    }
    <section class="mt-section rounded bg-surface p-8">
      <h2 class="text-2xl font-bold">Fewer than twelve people?</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        Then you do not need us at all — book a bay or two at the normal hourly rate and turn up. Up to six people per
        bay, same price.
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <BookButton size="lg" />
        <a href="#enquiry" class="inline-block rounded border-2 border-current px-8 py-4 font-semibold hover:bg-ink/5">
          Back to the enquiry form
        </a>
      </div>
      <p class="mt-6 text-sm text-inkMuted">
        Prefer to talk to someone? Call {venues[0]?.data.phone} or email {venues[0]?.data.email}.
      </p>
    </section>
  </section>
</BaseLayout>
