---
/**
 * Food & drink — the page that retires the six PNGs.
 *
 * HTML, never a PDF and never a PNG (playbook-core.md §8). Until FW-4002 the
 * live menu was 72 characters of text plus six images with empty alt attributes,
 * invisible to search, to AI answers and to a screen reader — the one ship-gate
 * rule the site was still breaking. Everything on this page now comes out of the
 * `menu` collection, so the client edits it in TinaCMS instead of exporting
 * another graphic.
 *
 * ## Four decisions worth not re-litigating
 *
 * **1. The hours here are `/rates`' hours, deliberately.** The printed menu says
 * `HOURS: SUN-SAT 8AM-10PM`; the venue record and `/rates` say 11am–9pm at
 * Lakeville. The client is fixing the print side, and the site publishes the
 * `/rates` version (client-answers.md §9; truth-audit §"the menu graphic"). So
 * the hero cell below is DERIVED from the venue record rather than typed — this
 * page cannot drift from the rates page because it does not hold its own copy of
 * the number. Do not paste 8am–10pm in here off the graphic.
 *
 * **2. Venue scope is on every section, not in a footnote.** Lakeville runs its
 * own bar and kitchen; Stillwater's food and drink are Stillwater Bowl &
 * Lounge's. Every section carries a `venue` and prints it, and Stillwater gets a
 * section that publishes no items at all — because there is nothing of ours to
 * publish there.
 *
 * **3. Nothing was invented to fill the layout.** Two of the client's graphics
 * describe the same $12 breakfast bowl differently, and the Hot Italian pizza's
 * topping list stops mid-sentence on a comma. Both ship as `GapCell` marks
 * naming what is unresolved — not as a guess, and not as the string "TBD" in a
 * value slot, which is the flat-page behaviour the gap system exists to replace.
 * Beer, seltzers and soft drinks are named on the printed menu and priced
 * nowhere on it; that is a gap too, not a reason to drop the list.
 *
 * **4. Appetisers run high price to low, and that is a design decision.** The
 * source order is an artefact of two graphics laid out around photographs.
 * Sorting the ledger by price makes the scoreboard column read as a column —
 * which is the point of setting prices in the tabular numeric face — and the
 * dish the venue leads with in print (brisket burnt ends, the dearest thing on
 * it) still leads here. Items and prices are untouched; only the running order
 * is ours. Reorder the array in the collection if the venue wants its own
 * merchandising back.
 *
 * ⚠️ The metadata below restores the `seo-map.md` §2 wording. That version
 * promised "the whole menu in text, with prices" and named brisket burnt ends,
 * and was correctly retired by the truth audit (§U21) while this page held no
 * menu at all. The page holds the menu now, so the sentence is true again.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/venue/BookButton.astro';
import SectionHead from '../components/venue/SectionHead.astro';
import HeroStrip from '../components/venue/HeroStrip.astro';
import MenuSection from '../components/venue/MenuSection.astro';
import MenuSchema from '../components/venue/MenuSchema.astro';
import ReadoutCell from '../components/venue/ReadoutCell.astro';
import { getVenues, appliesTo, orderedHours, formatTime, type VenueScope } from '../lib/venues';
import { globalData } from '../data/global';

const venues = await getVenues();
const sections = (await getCollection('menu')).sort((a, b) => a.data.order - b.data.order);

const lakeville = venues.find((v) => v.data.slug === 'lakeville');
const stillwater = venues.find((v) => v.data.slug === 'stillwater');
const stillwaterHost = stillwater?.data.containedInPlace ?? 'Stillwater Bowl & Lounge';

/**
 * Lakeville's opening window, read off the venue record — the same record
 * `/rates` renders. Collapsed to one figure only when all seven days agree; the
 * moment they stop agreeing the cell becomes a gap instead of quietly publishing
 * Monday's hours as though they were the week's.
 */
const lakevilleRows = lakeville ? orderedHours(lakeville) : [];
const uniformHours =
  lakevilleRows.length > 0 &&
  lakevilleRows.every((r) => !r.closed && r.opens === lakevilleRows[0].opens && r.closes === lakevilleRows[0].closes);
const hoursValue = uniformHours ? `${formatTime(lakevilleRows[0].opens)}–${formatTime(lakevilleRows[0].closes)}` : null;

/** "$17" → 17. Anything that is not a plain money string is not a figure. */
const amount = (price?: string): number | null => {
  const match = price ? /^\$?\s*(\d+(?:\.\d{1,2})?)$/.exec(price.trim()) : null;
  return match ? Number(match[1]) : null;
};
/** Both entry prices are DIVIDED out of the collection, never stored twice. */
const cheapest = (values: (number | null)[]) => {
  const found = values.filter((v): v is number => v !== null);
  return found.length ? Math.min(...found) : null;
};
const pizzaFrom = cheapest(
  sections.filter((s) => s.data.layout === 'grid').flatMap((s) => s.data.items.map((i) => amount(i.prices[0]))),
);
const plateFrom = cheapest(
  sections.filter((s) => s.data.layout === 'plates').flatMap((s) => s.data.items.map((i) => amount(i.price))),
);
const appetiserCount = sections.find((s) => s.data.layout === 'plates')?.data.items.length ?? 0;

const metadata = {
  metaTitle: 'Food & Drink Menu — The Links, Lakeville MN',
  metaDescription:
    'Full bar, Minnesota thin-crust pizza, wings and brisket burnt ends at The Links of Lakeville, MN. The whole menu in text, with prices.',
};

const venueName = (scope: VenueScope) =>
  scope === 'both' ? 'Both venues' : (venues.find((v) => appliesTo(scope, v.data.slug))?.data.name ?? scope);

/**
 * White, greige, white, greige… so every section owns a band of its own and a
 * ground change does the work a divider would otherwise have to do. Counted from
 * the "whose kitchen" band above, which is white — so the first menu section is
 * index 1 and lands on greige. Two adjacent white bands would put a section
 * boundary where the eye cannot see one.
 */
const isGreige = (i: number) => i % 2 === 1;
const band = (i: number) => (isGreige(i) ? 'bg-greige' : 'bg-white');
---

<BaseLayout metadata={metadata}>
  {
    /* 1. HERO + the 4-cell strip. What a person screens on before reading a
      menu: what the two things this kitchen is known for start at, when it is
      open, and what paying is going to cost them. */
  }
  <section class="on-dark bg-midnight">
    <div class="mx-auto max-w-content px-gutter pt-s8 pb-s7 lg:px-gutter-lg lg:pt-s9 lg:pb-s8">
      <p class="caps-label text-amber">Eat and drink in the bay</p>
      <h1 class="mt-s5 text-hero leading-hero font-extrabold tracking-display-tight text-white">Food &amp; drink</h1>
      <p class="mt-s5 max-w-prose-page border-l-slab border-amber pl-s4 text-lead leading-body text-paper">
        Nobody expects you to stop playing to sit at a table. Order from the bay, the tab runs through the venue, and
        one person settles it at the end.
      </p>

      <HeroStrip
        class="mt-s8"
        tone="dark"
        cells={[
          pizzaFrom !== null
            ? { label: 'Pizza from', value: `$${pizzaFrom}`, qualifier: '14-inch Minnesota thin crust' }
            : {
                label: 'Pizza from',
                gap: { state: 'notSet' as const, reason: 'No pizza is priced in the menu collection yet.' },
              },
          plateFrom !== null
            ? {
                label: 'Off the menu from',
                value: `$${plateFrom}`,
                qualifier: `${appetiserCount} appetisers, all of them shareable`,
              }
            : {
                label: 'Off the menu from',
                gap: { state: 'notSet' as const, reason: 'Nothing on the food ledger carries a price yet.' },
              },
          hoursValue
            ? { label: 'Kitchen hours', value: hoursValue, qualifier: 'Every day at Lakeville' }
            : {
                label: 'Kitchen hours',
                gap: {
                  state: 'notSet' as const,
                  reason: 'The week is no longer one window. The full schedule is on the rates and hours page.',
                },
              },
          { label: 'Card surcharge', value: '3%', qualifier: 'Cash and debit avoid it' },
        ]}
      />
    </div>
  </section>

  {
    /* 2. WHOSE KITCHEN. Two venues, two different businesses cooking. Saying so
      plainly beats implying one menu across both, and "one menu across both" is
      the thing this page is most likely to be misread as claiming. */
  }
  <section class="bg-white">
    <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
      <SectionHead>Whose kitchen you are ordering from</SectionHead>
      <dl class="border-t-score border-navy">
        <div
          class="grid gap-s3 border-b-hairline border-navy py-row md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-s6"
        >
          <dt class="caps-label text-label-sm text-inkMuted">{lakeville?.data.name ?? 'The Links of Lakeville'}</dt>
          <dd class="ml-0 max-w-prose-page text-body leading-body text-inkBody">
            Ours. A full bar and a food menu of its own — draft and canned beer, seltzers, cocktails, soft drinks, and a
            kitchen built around Minnesota thin-crust pizza, wings and appetisers. Nine screens, so the game is on
            whether or not you are playing. Everything priced on this page is theirs.
          </dd>
        </div>
        <div class="grid gap-s3 border-b-score border-navy py-row md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-s6">
          <dt class="caps-label text-label-sm text-inkMuted">{stillwater?.data.name ?? 'The Links of Stillwater'}</dt>
          <dd class="ml-0 max-w-prose-page text-body leading-body text-inkBody">
            Not ours. The bays sit inside {stillwaterHost}, and the food and drink come from them — burgers, bites and a
            full bar. One building and one evening out, but not our kitchen, and not the menu below.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {/* 3. THE MENU ITSELF. One band per section, alternating ground. */}
  {
    sections.map((entry, i) => (
      <section class={band(i + 1)}>
        <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
          <MenuSection
            entry={entry}
            index={i + 1}
            venueLabel={venueName(entry.data.venue)}
            onGreige={isGreige(i + 1)}
          />
        </div>
      </section>
    ))
  }

  {
    /* 4. PAYING. The surcharge is disclosed on the menu graphic and nowhere in
      the booking flow. It belongs in text, before somebody is at the till. */
  }
  <section class={band(sections.length + 1)}>
    <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
      <SectionHead index={sections.length + 1}>Paying</SectionHead>
      <div class="flex flex-wrap gap-x-s8 gap-y-s6">
        <ReadoutCell label="Credit card" size="md">3% surcharge</ReadoutCell>
        <ReadoutCell label="Cash and debit" size="md">No surcharge</ReadoutCell>
        <ReadoutCell label="Members" size="md">10% off food and drink</ReadoutCell>
      </div>
      <p class="mt-s6 max-w-prose-page text-body leading-body text-inkBody">
        The card fee covers what the venue is charged to process the payment and is never more than that. At Stillwater
        the till belongs to {stillwaterHost}, so their rules apply rather than ours.
      </p>
    </div>
  </section>

  {/* Every page ends in a transactional CTA (playbook-core.md §6). */}
  <section class="on-dark bg-midnight">
    <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
      <SectionHead tone="dark">Hungry, and free tonight?</SectionHead>
      <p class="max-w-prose-page text-lead leading-body text-paper">
        Book a bay by the hour and order from it. Up to six of you for the same price, and nobody has to be any good.
      </p>
      <div class="mt-s6"><BookButton size="lg" variant="onDark" /></div>
    </div>
  </section>

  {
    lakeville && (
      <MenuSchema
        sections={sections.filter((s) => s.data.venue === 'lakeville')}
        venueId={`${globalData.siteUrl}/locations/${lakeville.data.slug}/#venue`}
        venueName={lakeville.data.name}
      />
    )
  }
</BaseLayout>
