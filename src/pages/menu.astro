---
/**
 * HTML, never a PDF and never a PNG (playbook-core.md §8). The current /menu is
 * 72 characters of text plus six PNGs with empty alt attributes — invisible to
 * search, to AI answers, and to a screen reader. This page is the fix, and the
 * menu lives in the `menu` content collection so the client can edit it in
 * TinaCMS rather than exporting another graphic.
 *
 * ⚠️ The metadata below NO LONGER matches seo-map.md §2, on purpose. That version
 * promised "the whole menu in text, with prices" and named brisket burnt ends —
 * on a page that contains no menu and no prices, because the items are only
 * readable off the client's menu images and every price needs re-confirming. A
 * meta description is the sentence Google prints under the result, so it was the
 * one claim on this page a visitor met BEFORE they could see it was untrue
 * (truth-audit §U21). It now describes what the page actually holds. Restore the
 * seo-map wording only once the `menu` collection carries real priced items —
 * `hasRealItems` below is the switch that tells you.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookButton from '../components/venue/BookButton.astro';
import { getVenues, appliesTo, type VenueScope } from '../lib/venues';

const venues = await getVenues();
const sections = (await getCollection('menu')).sort((a, b) => a.data.order - b.data.order);

/** A section is a real menu section once it carries priced items and no stub note. */
const isStub = (note?: string) => Boolean(note && note.trim().toUpperCase().startsWith('STUB'));
const hasRealItems = sections.some((s) => !isStub(s.data.note) && s.data.items.length > 0);

const metadata = {
  metaTitle: 'Food & Drink Menu — The Links, Lakeville MN',
  metaDescription:
    'Full bar, Minnesota thin-crust pizza, wings and appetisers at The Links of Lakeville, MN. What to expect, and how paying works.',
};

const venueName = (scope: VenueScope) =>
  scope === 'both' ? 'Both venues' : (venues.find((v) => appliesTo(scope, v.data.slug))?.data.name ?? scope);
---

<BaseLayout metadata={metadata}>
  <section class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg">
    <h1 class="text-4xl font-bold lg:text-5xl">Food &amp; drink</h1>
    <p class="mt-4 max-w-2xl text-lg text-inkMuted">
      You can eat and drink in the bay. Nobody expects you to stop playing to sit at a table, and the tab runs through
      the venue so one person settles it at the end.
    </p>

    {
      /* Which kitchen you are ordering from depends on which venue you are in.
       Saying so plainly beats implying one menu across two businesses. */
    }
    <section class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded border-2 border-ink/15 p-6">
        <h2 class="text-xl font-semibold">Lakeville</h2>
        <p class="mt-2 text-inkMuted">
          Full bar and a food menu of its own. Draft and canned beer, seltzers, cocktails, soft drinks, and a menu built
          around Minnesota thin-crust pizza, wings and appetisers. Nine screens, so the game is on whether or not you
          are playing.
        </p>
      </div>
      <div class="rounded border-2 border-ink/15 p-6">
        <h2 class="text-xl font-semibold">Stillwater</h2>
        <p class="mt-2 text-inkMuted">
          The bays sit inside Stillwater Bowl &amp; Lounge, and the food and drink come from them — burgers, bites and a
          full bar. It is one building and one visit; it is not our kitchen.
        </p>
        <p class="mt-3 text-sm text-inkMuted">
          <strong>STUB —</strong> whether Stillwater Bowl's menu is published here, linked, or left to the host has not been
          decided with the client.
        </p>
      </div>
    </section>

    {/* The menu itself, from the content collection. Prices are text. */}
    <section class="mt-section">
      <h2 class="text-3xl font-bold">The menu</h2>

      {
        !hasRealItems && (
          <div class="mt-6 rounded border-2 border-dashed border-ink/25 p-6">
            <p class="font-semibold">STUB — the menu has not been transcribed yet.</p>
            <p class="mt-3 text-inkMuted">
              The current site publishes its entire menu as six images with no text alternative, so the items and prices
              are not machine-readable and could not be lifted safely during handover. Two of those images also give the
              same dish two different descriptions, so a straight copy would ship a contradiction.
            </p>
            <p class="mt-3 text-inkMuted">
              <strong>Needed from the client:</strong> the current menu as text — every section, every item, every
              price, including beer and soft drinks, which are not priced on the graphic at all. Once it is in the CMS
              this page fills itself in.
            </p>
          </div>
        )
      }

      {
        sections.map((section) => (
          <section class="mt-10">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-2xl font-semibold">{section.data.section}</h3>
              <span class="text-sm text-inkMuted">{venueName(section.data.venue)}</span>
            </div>

            {section.data.items.length > 0 && (
              <dl class="mt-4 divide-y divide-ink/10">
                {/*
                  dt/dd must be direct children of the dl, or of a single div
                  child of it. Wrapping them in a second nested div broke the
                  grouping (axe: definition-list / dlitem), so the layout is done
                  with flex order and a full-width description row instead.
                */}
                {section.data.items.map((item) => (
                  <div class="flex flex-wrap items-baseline justify-between gap-x-6 py-3">
                    <dt class="max-w-xl font-medium">{item.name}</dt>
                    {item.price && <dd class="font-semibold">{item.price}</dd>}
                    {item.description && <dd class="mt-1 w-full max-w-xl text-sm text-inkMuted">{item.description}</dd>}
                  </div>
                ))}
              </dl>
            )}

            {section.data.note && (
              <p class="mt-4 rounded border-2 border-dashed border-ink/25 p-4 text-sm text-inkMuted">
                {section.data.note}
              </p>
            )}
          </section>
        ))
      }
    </section>

    {
      /* Paying. The surcharge is disclosed on the menu graphic and nowhere in the
       booking flow — it belongs in text, before someone is at the till. */
    }
    <section class="mt-section">
      <h2 class="text-3xl font-bold">Paying</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        There is a <strong>3% surcharge on credit card payments</strong>. Cash and debit avoid it. Members get 10% off
        food and drink.
      </p>
      <p class="mt-4 max-w-2xl rounded border-2 border-dashed border-ink/25 p-4 text-sm text-inkMuted">
        <strong>STUB —</strong> the 3% card surcharge appears only on the menu graphic today and nowhere in the booking flow.
        Confirm it still applies, and confirm whether it applies at Stillwater, where the till belongs to Stillwater Bowl.
      </p>
    </section>

    <p class="mt-section rounded border-2 border-dashed border-ink/25 p-4 text-sm text-inkMuted">
      <strong>STUB —</strong> real food photography. The playbook asks for photographs of the actual food; none were supplied
      and stock imagery is a ship-blocker.
    </p>

    {/* Every page ends in a transactional CTA (playbook-core.md §6). */}
    <section class="mt-section rounded bg-surface p-8">
      <h2 class="text-2xl font-bold">Hungry and free tonight?</h2>
      <p class="mt-3 max-w-2xl text-inkMuted">
        Book a bay by the hour and order from the bay. Up to six of you for the same price.
      </p>
      <div class="mt-6"><BookButton size="lg" /></div>
    </section>
  </section>
</BaseLayout>
