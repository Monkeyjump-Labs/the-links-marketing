---
/**
 * Homepage. Two lines of composition, because the parts moved out on 2026-08-27
 * and the reasoning moved with them:
 *
 *   - the hero is `components/home/HeroBleed.astro` — the film full bleed, the
 *     words on a navy panel hanging past it
 *   - everything below it is `components/home/HomeSections.astro`
 *
 * The split exists so the client can compare this hero against the one it
 * replaced, at `/hero-original/`, without two copies of the page drifting apart.
 * **When they pick, delete the loser and its page and fold the winner back in
 * here if you like** — this shape earns its keep only while there are two.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBleed from '../components/home/HeroBleed.astro';
import HomeSections from '../components/home/HomeSections.astro';

const metadata = {
  metaTitle: 'Indoor Golf & Simulators — Lakeville & Stillwater, MN',
  metaDescription:
    'Two indoor golf venues in the Twin Cities. Book a GolfZon bay by the hour, bring up to six people, full bar and food. Lakeville and Stillwater, MN.',
};
---

<BaseLayout metadata={metadata}>
  <HeroBleed />
  <HomeSections />
</BaseLayout>
