---
/**
 * Homepage — the `blue-navy` composition (design/candidates/home-blue-navy.html,
 * wisplet rv_TPEdpfhufWV9Me variant var_m5Ht7Z, chosen 2026-08-02).
 *
 * Section order is the playbook's, ordered by the decision the visitor is
 * making (playbook-core.md §4) — not by what the client is proudest of. The
 * trust strip sits immediately under the hero because 67% of simulator venues
 * have no hours on the homepage at all.
 *
 * The direction's one committed idea, in its own words: *the page is one blue
 * ramp of six stops — from the room at night to the screen on the wall — plus
 * one warm accent*, rendered as **a scoreboard, not a brochure**. In practice
 * that means three things this file is responsible for:
 *
 * 1. **Full-bleed ground alternation.** midnight → white → midnight → white →
 *    EMBER → white. The ember band is used ONCE, at full strength; a second one
 *    would spend the only heat on the page.
 * 2. **Facts in labelled cells on a visibly ruled grid.** Hours, phone and bay
 *    counts are `ReadoutCell`s — a caps label over a figure at scoreboard scale
 *    — not sentences a visitor has to read to find a number in.
 * 3. **Hierarchy from weight and scale, never from decoration.** No shadows, no
 *    gradients, one 3px radius on interactive controls and nothing else.
 *
 * COPY: unchanged from what was already here, which was written for The Links
 * and audited clean of the reference site's vocabulary. Nothing was imported
 * from the candidate HTML that was not already on the site — notably the
 * candidate's "Celebrate" card stays **Events** and its `/food-and-drink/`
 * stays `/menu/`, per sitemap.md §0 (labels come from the corpus, not from a
 * reference site). The one change is a treatment, not a rewrite: *"Up to six
 * of you, same price."* is split out of the Play row's sentence so the
 * reassurance can carry the loudest type on the band, which is the direction's
 * stated beginner move.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustStrip from '../components/venue/TrustStrip.astro';
import BookButton from '../components/venue/BookButton.astro';
import WaitlistForm from '../components/venue/WaitlistForm.astro';
import StubNote from '../components/venue/StubNote.astro';
import SectionHead from '../components/venue/SectionHead.astro';
import ReadoutCell from '../components/venue/ReadoutCell.astro';
import MediaSlot from '../components/venue/MediaSlot.astro';
import HeroFilm from '../components/venue/HeroFilm.astro';
import { buttonClasses } from '../lib/buttons';
import { getVenues, venuePath } from '../lib/venues';
import stillwaterRoom from '../assets/images/stillwater-room.jpg';
import lakevilleNightPoster from '../assets/images/lakeville-night-poster.jpg';

const venues = await getVenues();
const leagues = (await getCollection('leagues')).filter((l) => l.data.published);
const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
// Gate the wrapper too, not just the note — otherwise production renders an
// empty padded div where the staging marker used to be.
const isStaging = import.meta.env.PUBLIC_SITE_NOINDEX === 'true';

const metadata = {
  metaTitle: 'Indoor Golf & Simulators — Lakeville & Stillwater, MN',
  metaDescription:
    'Two indoor golf venues in the Twin Cities. Book a GolfZon bay by the hour, bring up to six people, full bar and food. Lakeville and Stillwater, MN.',
};

/**
 * "What you can do here" — jobs, not departments (anti-pattern: org-shaped nav).
 * Each row is labelled with the PAGE IT LINKS TO, not with venue-voice copy.
 * "Celebrate" was On The Green's word for this row and appears once across the
 * 96 SIMULATOR-VENUE sites in the playbook corpus; the page is called Events, so
 * the row is too. (96 and 126 are both real and both the playbook's: 126 is the
 * whole corpus, sim venues plus golf courses; 96 is the sim-venue subset that
 * `playbook-sim-venue.md` is measured on. Always say which — two bare numbers in
 * one project reads as sloppiness. See truth-audit.md §U23.)
 *
 * `reassure` is the sentence that gets the loudest treatment on the band. The
 * beginner is the segment's largest untapped market and 67% of league pages in
 * the corpus fail beginner reassurance, so the volume is spent here rather than
 * on the flex.
 */
interface Job {
  title: string;
  body: string;
  reassure?: string;
  href: string;
}

const things: Job[] = [
  { title: 'Play', body: 'Book a bay by the hour.', reassure: 'Up to six of you, same price.', href: '/book/' },
  { title: 'Compete', body: 'Fall and winter league play, planned at both venues.', href: '/leagues/' },
  { title: 'Events', body: 'Work parties, birthdays, bachelor parties.', href: '/events/' },
  { title: 'Improve', body: 'Lessons and practice on a real launch monitor.', href: '/lessons/' },
  { title: 'Eat & drink', body: 'Full bar, real food, nine screens.', href: '/menu/' },
];

/**
 * The media slots, per venue. **Deliberately asymmetric, because the truth is**
 * — and since FW-4003 the asymmetry points the other way, which is what should
 * happen when a slot is filled from fact rather than from taste.
 *
 * **Stillwater is now a real photograph.** The client supplied a walkthrough
 * video of that room, and this is a still from it: the first honest image of
 * Stillwater the site has ever carried. It is handheld phone footage of an
 * empty room rather than a commissioned shoot, so the caption says so and the
 * staging marker still asks for the shoot.
 *
 * **Lakeville is still drawn, lit.** Its professional shoot exists but the files
 * have not been delivered, so there is nothing real to put here yet.
 *
 * The rule underneath is unchanged: Lakeville's frames never stand in for
 * Stillwater. That swap is the exact trust defect this rebuild exists to fix.
 */
const slots: Record<
  string,
  { photo?: ImageMetadata; lit: boolean; alt: string; label: string; caption: string; needs: string }
> = {
  lakeville: {
    lit: true,
    alt: 'Photo slot at 3:2 — the frame that belongs here is a wide interior of the Lakeville room, evening, occupied: a near-black navy room, warm pendant light over the bar, and the lit simulator projection as the one bright cool thing in it.',
    label: 'Photo slot · 3:2 · wide interior, evening, occupied',
    caption:
      'A professional shoot of this room exists — warm, dark, pendant-lit, with the simulator projection as the only cool note. The files are not on the site yet.',
    needs: 'deliver the files',
  },
  stillwater: {
    photo: stillwaterRoom,
    lit: false,
    alt: 'The Stillwater room seen down its length: two lit simulator screens on the far wall, high-top tables and stools on a pale wood floor, a leather couch to the right, and a black ceiling hung with track lights. The room is empty.',
    label: 'Stillwater · from the venue’s own walkthrough',
    caption:
      'A still from the walkthrough video the venue filmed — the first real picture of this room on the site. It is handheld footage of an empty room, not a professional shoot.',
    needs: 'a professional shoot — this room has still never been photographed lit for camera or occupied',
  },
};
---

<BaseLayout metadata={metadata}>
  {
    /* 1. HERO — the room at night, WITH THE SCREEN IN IT. Promise + what it is
      + where, one primary CTA. Venue-neutral by design: the venue question is
      asked at the Book click, not the front door. The subhead carries an 8px
      amber slab rather than an opacity — the block this replaced set its eyebrow
      at opacity-70 and its subhead at opacity-80, both of which re-derive their
      own contrast against whatever ground they land on.

      **The client's film is now the hero** (FW-4010), which FW-4003 declined —
      and the way it is declined matters, because the refusal was measured and
      the measurement was right. What it measured was ONE structure: display type
      composited over moving footage. So the film is here on a structure that
      composites nothing: the promise SPANS the grid, then the band opens into
      two columns — the words on solid midnight, the film beside them as a ruled
      screen. Contrast stops being a per-frame property and goes back to being a
      token pairing, and the film runs unscrimmed, which is the only version of
      it anyone actually wanted to look at. The re-measurement on the file that
      ships, and the two rejected structures, are in `HeroFilm`.

      The h1 spans both columns rather than sitting in one: `text-hero` peaks at
      5.25rem, which needs most of `max-w-content` to stay at two lines. A split
      that boxes it into half the width forces either five lines or a smaller
      step, and the page's single largest gesture is not the thing to trade away
      for a layout. Spanning it also makes the row beneath rhyme with the "Two
      venues" rows — media cell beside text cell on a ruled grid — rather than
      importing a video-hero composition from somewhere else.

      The left cell is `self-start` so the subhead's 8px amber slab starts on the
      same line as the film's top rule — measured in the browser at 1440, both at
      y=294 within the band. Bottom-aligning instead (tried, screenshotted,
      rejected) buys an alignment with the caption's last line, which is a weaker
      edge, and drops the primary CTA ~150px down the page to get it. The
      midnight left under the buttons is the field, not a gap.

      DOM order is eyebrow → h1 → words → film, on every viewport. On mobile that
      puts the film below the CTAs: an autoplaying clip above the promise buries
      both the h1 and the primary action on the device where the action matters
      most, and reordering it visually would split tab order from reading order
      around a focusable pause control. The film is still inside the hero band. */
  }
  <section class="on-dark bg-midnight">
    <div class="mx-auto max-w-content px-gutter pt-s8 pb-s7 lg:px-gutter-lg lg:pt-s9 lg:pb-s8">
      <div class="grid gap-y-s5 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-x-s8">
        <p class="caps-label text-amber lg:col-span-2">Lakeville &amp; Stillwater, Minnesota</p>
        {
          /* THE CLIENT'S OWN HEADLINE, restored verbatim from their live homepage
            (`_ingest/raw/home.html`) and approved for reuse 2026-08-04 (FW-4000).
            Ours was "Indoor golf that's actually a night out." — which is fine, and
            theirs is better, because it is the sentence they already say about
            themselves. The subhead keeps the night-out job, so nothing is lost. */
        }
        <h1 class="text-hero leading-hero font-extrabold tracking-display-tight text-white lg:col-span-2">
          The most realistic indoor golf you can play, period.
        </h1>

        <div class="lg:self-start">
          <p class="max-w-prose-page border-l-slab border-amber pl-s4 text-lead leading-body text-paper">
            Ten GolfZon bays across two Twin Cities venues. Book by the hour, bring up to six people for the same price,
            and let the simulator keep score while you order another round.
          </p>
          <div class="mt-s6 flex flex-wrap gap-s4">
            <BookButton size="lg" variant="onDark" />
            <a href="/rates/" class={buttonClasses('lg', 'ghostDark')}>See rates &amp; hours</a>
          </div>
        </div>

        <HeroFilm
          name="lakeville-night"
          poster={lakevilleNightPoster}
          alt="Silent video: a group of friends around a table with drinks and food in the Lakeville room, then a player stepping up and hitting a shot into a lit simulator screen."
          caption="Filmed at The Links of Lakeville by the venue, with no sound. Stillwater is a different and newer room, and we will not let this stand in for it."
        />
      </div>
    </div>
  </section>

  {
    /* 2. TRUST STRIP — hours, address, phone on a hard white cut out of the
      hero. The cheapest, highest-impact block in the segment, so it is a
      readout rail rather than a caption bar. */
  }
  <TrustStrip />

  {
    /* 3. WHAT YOU CAN DO HERE — a row list, not a card grid. Rows put the five
      jobs in one scannable column at one scale, and the first row is weighted
      because booking a bay is the job most visitors came for. Hover moves ONE
      STOP UP THE SAME RAMP (midnight → navy) rather than changing hue, so it
      reads as lit rather than as a different colour — and because slate on navy
      is 4.16:1, no muted text is allowed inside a row. */
  }
  <section class="on-dark bg-midnight">
    <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
      <SectionHead tone="dark">What you can do here</SectionHead>

      <ul class="border-t-hairline border-t-paper">
        {
          things.map((t, i) => (
            <li class:list={['border-b-hairline border-b-paper', i === 0 && 'border-t-slab border-t-amber']}>
              <a
                href={t.href}
                class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-s5 gap-y-s3 py-row transition-colors duration-fast ease-standard hover:bg-navy md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)_auto] md:items-center md:py-s7"
              >
                <h3
                  class:list={[
                    'col-start-1 row-start-1 leading-display font-bold tracking-display text-white',
                    i === 0 ? 'text-row-lead' : 'text-row',
                  ]}
                >
                  {t.title}
                </h3>
                <p class="col-start-1 col-end-3 row-start-2 text-lead leading-body text-paper md:col-start-2 md:col-end-3 md:row-start-1">
                  {t.body}
                  {t.reassure && (
                    <span class="mt-s2 block font-display text-card leading-display font-bold tracking-display text-amber">
                      {t.reassure}
                    </span>
                  )}
                </p>
                <span
                  aria-hidden="true"
                  class="col-start-2 row-start-1 justify-self-end font-display text-row leading-score font-extrabold text-amber md:col-start-3"
                >
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    /* 4. PROOF. 81% of the segment shows no reviews at all — but we will not
      invent testimonials, and an empty "What players say" heading is worse than
      no section. So the band exists in production only when there is real,
      attributed proof to put in it; on staging it renders the DESIGNED
      reservation instead — three ruled slots naming what each one is waiting
      for — so a client reviewing the link sees the shape of the gap. */
  }
  {
    testimonials.length > 0 && (
      <section class="bg-white">
        <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
          <SectionHead>What players say</SectionHead>
          <div class="grid border-t-score border-navy md:grid-cols-3">
            {testimonials.slice(0, 3).map((t, i) => (
              <div
                class:list={[
                  'flex flex-col justify-between gap-s5 border-b-hairline border-navy p-cell',
                  i > 0 && 'md:border-l-hairline',
                ]}
              >
                <blockquote class="text-lead leading-body text-inkBody">&ldquo;{t.data.quote}&rdquo;</blockquote>
                <p class="border-t-hairline border-inkMuted pt-s3 font-display text-small font-semibold text-inkMuted">
                  {t.data.name}
                  {t.data.source && ` · ${t.data.source}`}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    testimonials.length === 0 && isStaging && (
      <section class="bg-white">
        <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
          <SectionHead>What players say</SectionHead>
          <div class="grid border-t-score border-navy md:grid-cols-3">
            {[
              { state: 'awaiting', attr: 'Name · The Links of Lakeville' },
              { state: 'awaiting', attr: 'Name · The Links of Lakeville' },
              { state: 'blocked', attr: 'Name · The Links of Stillwater — no Google Business Profile on record' },
            ].map((slot, i) => (
              <div
                class:list={[
                  'hatch-reserved flex min-h-s10 flex-col justify-between gap-s5 border-b-hairline border-navy p-cell',
                  i > 0 && 'md:border-l-hairline',
                ]}
              >
                <p class="caps-label text-ink">Attributed review — {slot.state}</p>
                <div class="flex flex-1 flex-col justify-center gap-s4">
                  <span class="h-rule block w-full bg-inkMuted" />
                  <span class="h-rule block w-11/12 bg-inkMuted" />
                  <span class="h-rule block w-2/3 bg-inkMuted" />
                </div>
                <p class="border-t-hairline border-inkMuted pt-s3 font-display text-small font-semibold text-inkMuted">
                  {slot.attr}
                </p>
              </div>
            ))}
          </div>
          <StubNote
            class="mt-s6"
            needs="the proof section is not rendered in production — no attributed testimonials exist yet. Needed: three real quotes with permission to publish name and venue, plus the Google Business Profile link for each venue. 81% of comparable venues show no reviews at all, so this is a differentiator worth chasing."
          />
        </div>
      </section>
    )
  }

  {
    /* 5. THE FEATURED OFFER — the slot that changes monthly (strategy.md §5),
      and the page's ONE ember band, at full strength. Launching in the Sep–Oct
      window, so it is league registration.

      Nothing dark goes on this band: midnight on ember is 2.35:1 and navy
      1.79:1, which is the same measurement that forbids an ember fill on the
      hero, read the other way round. The waitlist therefore sits in a paper
      slab punched out of the band, and inside that slab everything reverts to
      light-field styling. */
  }
  <section class="on-accent-band bg-primary">
    <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
      <div class="grid gap-s7 lg:grid-cols-2 lg:items-start lg:gap-s9">
        <div>
          <p class="caps-label text-white">This season</p>
          <h2 class="mt-s4 text-section leading-display font-extrabold tracking-display-tight text-white">
            Fall &amp; winter leagues
          </h2>
          <p class="mt-s5 text-lead leading-body text-surface">
            Teams, handicaps, a live leaderboard and a bar tab. Registration for {
              leagues[0]?.data.season ?? 'the coming season'
            } has not opened yet — join the list and you will hear the day it does.
          </p>
          <p
            class="my-s6 border-y-score border-white py-s4 font-display text-row leading-display font-bold tracking-display text-white"
          >
            Never played in one? Handicaps keep it fair — a first-timer and a scratch player can be on the same team.
          </p>
          <a
            href="/leagues/"
            class="inline-flex min-h-tap items-center font-bold text-surface underline decoration-2 underline-offset-4 transition-colors duration-fast ease-standard hover:text-white"
          >
            See how leagues work
          </a>
        </div>

        <WaitlistForm
          listName="league-general"
          heading="Get first word on league sign-ups"
          blurb="One email when registration opens. Nothing else."
        />
      </div>
    </div>
  </section>

  {
    /* 6. TWO VENUES — alternating rows on a ruled grid, each carrying its bay
      count and its simulator as labelled cells. The media column is a drawn
      spec at the real 3:2, never a fake photograph: there is no venue
      photography in this project and stock golf imagery is a ship-blocker
      (playbook §9). See MediaSlot for why the two slots differ. */
  }
  <section class="bg-white">
    <div class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg lg:py-section-lg">
      <SectionHead>Two venues</SectionHead>

      {
        venues.map((venue, i) => {
          const slot = slots[venue.data.slug];
          const last = i === venues.length - 1;
          return (
            <div
              class:list={[
                'grid gap-s6 border-navy py-s7 lg:grid-cols-[minmax(0,4fr)_minmax(0,3fr)] lg:items-center lg:gap-s8',
                i === 0 ? 'border-t-score' : 'border-t-hairline',
                last && 'border-b-score',
              ]}
            >
              <div class:list={[i % 2 === 1 && 'lg:order-2']}>
                {slot && <MediaSlot id={venue.data.slug} {...slot} />}
              </div>

              <div class:list={[i % 2 === 1 && 'lg:order-1']}>
                <h3 class="text-row leading-display font-extrabold tracking-display text-ink">{venue.data.name}</h3>

                <div class="mt-s4 flex flex-wrap items-end gap-s7 border-y-quiet border-navy py-s4">
                  <ReadoutCell label="Bays" size="xl">
                    {venue.data.bays}
                  </ReadoutCell>
                  <ReadoutCell label="Simulator" size="name">
                    {venue.data.simulator}
                  </ReadoutCell>
                </div>

                <p class="mt-s5 max-w-prose-page text-lead leading-body text-inkBody">{venue.data.intro}</p>

                <div class="mt-s5 flex flex-wrap items-center gap-s5">
                  <BookButton venue={venue} />
                  <a
                    href={venuePath(venue)}
                    class="inline-flex min-h-tap items-center font-bold text-inkBody underline decoration-2 underline-offset-4 transition-colors duration-fast ease-standard hover:text-ember"
                  >
                    Venue details
                  </a>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  {
    /* The film used to close the page here as a band ("What a night here looks
      like", FW-4003). It is the hero now, and one clip cannot be the page's
      opening gesture and its closing one — so the band is gone rather than
      duplicated. Two consequences, both deliberate:

      - The ground alternation is six bands, not seven: midnight → white →
        midnight → white → EMBER → white. It still alternates and it still
        spends the ember exactly once.
      - The page no longer closes on midnight against the light footer. The cut
        is now the footer's own 2px rule, which is how every other page on the
        site ends. */
  }
</BaseLayout>
