---
/**
 * The local-SEO anchor: NAP for BOTH venues, hours, phone, directions.
 *
 * ── STUB PASS 2026-08-05 (FW-4013) ─────────────────────────────────────────
 *
 * This page ended in one line of raw build notes: "STUB — a contact form, an
 * embedded map per venue, and parking guidance are still to be added. Job
 * enquiries currently go to hr@lakevillelinks.com." Three different things in
 * one sentence, and only one of them was ever addressed to a visitor.
 *
 *   the form and the maps    work we owe. `StubNote`, staging only.
 *   parking                  carried a `GapCell` until the owner asked for it
 *                            to come off (2026-09-08). The fact was never
 *                            supplied; the mark said so, and saying so is no
 *                            longer wanted. If the venues ever describe their
 *                            car parks it goes back as ordinary copy, not as
 *                            a mark.
 *   hr@lakevillelinks.com    a REAL, USABLE ADDRESS that was buried inside a
 *                            stub. It is published as ordinary copy now, which
 *                            is what it should have been all along.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HoursTable from '../components/venue/HoursTable.astro';
import BookButton from '../components/venue/BookButton.astro';
import PendingTag from '../components/venue/PendingTag.astro';
import StubNote from '../components/venue/StubNote.astro';
import { getVenues, formatAddress, telHref, venuePath } from '../lib/venues';

const venues = await getVenues();

const metadata = {
  metaTitle: 'Contact & Hours — The Links, Lakeville & Stillwater MN',
  metaDescription:
    'Addresses, phone numbers and opening hours for both The Links venues — Lakeville in the south metro and Stillwater in the east metro.',
};
---

<BaseLayout metadata={metadata}>
  <section class="mx-auto max-w-content px-gutter py-section lg:px-gutter-lg">
    <h1 class="text-4xl font-bold lg:text-5xl">Contact</h1>

    <div class="mt-10 grid gap-12 md:grid-cols-2">
      {
        venues.map((venue) => (
          <div>
            <h2 class="text-2xl font-bold">
              <a href={venuePath(venue)} class="hover:underline">
                {venue.data.name}
              </a>
            </h2>
            <address class="mt-4 not-italic text-inkMuted">
              <a
                href={`https://maps.google.com/?q=${encodeURIComponent(formatAddress(venue))}`}
                class="hover:underline"
                target="_blank"
                rel="noopener"
              >
                {venue.data.streetAddress}
                <br />
                {venue.data.addressLocality}, {venue.data.addressRegion} {venue.data.postalCode}
              </a>
              <a href={telHref(venue.data.phone)} class="mt-3 block hover:underline">
                {venue.data.phone}
              </a>
              {venue.data.phoneNote && <PendingTag class="mt-s3" reason={venue.data.phoneNote} />}
              {venue.data.email && (
                <a href={`mailto:${venue.data.email}`} class="mt-1 block hover:underline">
                  {venue.data.email}
                </a>
              )}
            </address>
            <div class="mt-6">
              <HoursTable venue={venue} />
            </div>
            <div class="mt-6">
              <BookButton venue={venue} size="sm" variant="outline" />
            </div>
          </div>
        ))
      }
    </div>

    <section class="mt-section">
      <h2 class="text-2xl font-bold">Working here</h2>
      <div class="mt-6">
        <div>
          <p class="max-w-prose-page text-inkMuted">
            Job enquiries go to <a href="mailto:hr@lakevillelinks.com" class="font-semibold underline">
              hr@lakevillelinks.com
            </a>. Golf knowledge optional; enthusiasm for a warm building in February less so.
          </p>
        </div>
      </div>
      <StubNote
        class="mt-6"
        needs="Still to build on this page: a contact form routed through /api/lead, and an embedded map per venue."
      />
    </section>
  </section>
</BaseLayout>
