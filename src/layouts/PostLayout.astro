---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import type { PageMetadata } from '../lib/types';

interface Props {
  title: string;
  description: string;
  author?: string;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  metadata?: PageMetadata;
}

const { title, description, author, heroImage, heroImageAlt, metadata } = Astro.props;
---

<BaseLayout metadata={metadata ?? { metaTitle: title, metaDescription: description }}>
  <article class="mx-auto max-w-prose-page px-6 py-12 lg:px-16 lg:py-20">
    <header class="mb-12 lg:mb-20">
      <h1 class="mb-4 font-mono text-3xl font-normal leading-tight text-softBlack lg:text-5xl">{title}</h1>
      {description && <p class="mb-4 font-sans text-lg uppercase tracking-wide text-softBlack">{description}</p>}
      {
        heroImage && (
          <Image
            class="my-4 block h-auto w-full max-w-prose-page"
            src={heroImage}
            alt={heroImageAlt ?? title}
            widths={[480, 768, 1440]}
            sizes="(min-width: 75rem) 45rem, 100vw"
          />
        )
      }
      {author && <p class="font-mono text-base text-softBlack">Written by {author}</p>}
    </header>
    <div class="userEntered">
      <slot />
    </div>
  </article>
</BaseLayout>
