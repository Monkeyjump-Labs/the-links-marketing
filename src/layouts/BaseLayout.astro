---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import OrganizationSchema from '../components/venue/OrganizationSchema.astro';
import type { PageMetadata } from '../lib/types';

interface Props {
  metadata?: PageMetadata;
  /** Set false to omit the shared Header/Footer chrome (e.g. bare landing pages). */
  chrome?: boolean;
}

const { metadata = {}, chrome = true } = Astro.props;

// Staging deploys are noindex site-wide regardless of per-page metadata.
// Set PUBLIC_SITE_NOINDEX=true in the Vercel preview environment.
const noIndex = metadata.noIndex || import.meta.env.PUBLIC_SITE_NOINDEX === 'true';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <Seo
      title={metadata.metaTitle}
      description={metadata.metaDescription}
      shareImage={metadata.shareImage}
      twitterCardType={metadata.twitterCardType}
      noIndex={noIndex}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    {chrome && <Header />}
    <main class="flex-1">
      <slot />
    </main>
    {chrome && <Footer />}
    <OrganizationSchema />
  </body>
</html>
