---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import VenueBar from '../components/venue/VenueBar.astro';
import OrganizationSchema from '../components/venue/OrganizationSchema.astro';
import LeadFormScript from '../components/venue/LeadFormScript.astro';
import SubscribeBand from '../components/forms/SubscribeBand.astro';
import type { PageMetadata } from '../lib/types';

interface Props {
  metadata?: PageMetadata;
  /** Set false to omit the shared Header/Footer chrome (e.g. bare landing pages). */
  chrome?: boolean;
  /**
   * The subscribe strip above the footer. On by default, so a page added later
   * carries it without anyone remembering to opt in — the same reasoning as
   * mounting `LeadFormScript` here.
   *
   * Set false where an email capture would be wrong rather than merely
   * unhelpful:
   *   - `/thanks/`   they have just given us an address; asking again reads as
   *                  though the first one did not arrive
   *   - legal pages  `/privacy`, `/terms`, `/policy` — a marketing ask inside a
   *                  consent document undercuts the document
   *   - `/404`       nothing was found; do not sell to someone who is lost
   *   - `/styleguide` renders the component itself, so the strip would appear twice
   */
  subscribe?: boolean;
}

const { metadata = {}, chrome = true, subscribe = true } = Astro.props;

// Staging deploys are noindex site-wide regardless of per-page metadata.
// Set PUBLIC_SITE_NOINDEX=true in the Vercel preview environment.
const noIndex = metadata.noIndex || import.meta.env.PUBLIC_SITE_NOINDEX === 'true';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <Seo
      title={metadata.metaTitle}
      description={metadata.metaDescription}
      shareImage={metadata.shareImage}
      twitterCardType={metadata.twitterCardType}
      noIndex={noIndex}
    />
  </head>
  <body class="flex min-h-screen flex-col">
    {
      chrome && (
        <div class="sticky top-0 z-sticky">
          <Header />
          <VenueBar />
        </div>
      )
    }
    <main class="flex-1">
      <slot />
    </main>
    {
      /* Above the footer and outside `main`: it is chrome, not page content, so
        it sits alongside the footer in the document rather than inside the
        article a page's landmarks describe. Suppressed with the chrome, because
        a bare page (`chrome={false}`) has deliberately no site furniture. */
    }
    {chrome && subscribe && <SubscribeBand />}
    {chrome && <Footer />}
    <OrganizationSchema />
    {
      /* Progressive enhancement for every `/api/lead` form. Mounted site-wide
        rather than per-page: it is one delegated listener that does nothing at
        all on a page with no form, and mounting it here means a form added
        anywhere later cannot forget to opt in. The forms work without it. */
    }
    <LeadFormScript />
  </body>
</html>
