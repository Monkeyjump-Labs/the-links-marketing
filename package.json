{
  "name": "the-links-marketing",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "dev:astro": "astro dev",
    "build": "astro build",
    "tina:build": "tinacms build",
    "tina:lock": "TINA_CLIENT_ID=${TINA_CLIENT_ID:-tina-lock-dummy} TINA_TOKEN=${TINA_TOKEN:-tina-lock-dummy} TINA_BRANCH=${TINA_BRANCH:-main} tinacms build --skip-cloud-checks && node scripts/tina-lock.mjs",
    "tina:lock:check": "TINA_CLIENT_ID=${TINA_CLIENT_ID:-tina-lock-dummy} TINA_TOKEN=${TINA_TOKEN:-tina-lock-dummy} TINA_BRANCH=${TINA_BRANCH:-main} tinacms build --skip-cloud-checks && node scripts/tina-lock.mjs --check",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx,.astro",
    "format": "prettier --write src",
    "prepare": "husky install"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/react": "^4.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@tinacms/cli": "^1.6.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^8.0.3",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "prettier-plugin-astro": "^0.14.1",
    "tinacms": "^2.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "prettier --write"
    ]
  }
}
