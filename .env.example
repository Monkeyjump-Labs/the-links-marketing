# Contact form POST endpoint (used by src/components/contact/ContactForm.tsx)
PUBLIC_LEAD_ENDPOINT=https://example.invalid/your-logic-app-url-here

# ── TinaCMS ────────────────────────────────────────────────────────────────
# LOCAL MODE (default): leave these unset. `npm run dev` runs Tina against the
# local filesystem with no cloud account — edits write straight to src/content.
#
# TINA CLOUD (optional, for hosted multi-user editing): create a project at
# https://app.tina.io, then set:
# TINA_CLIENT_ID=your-tina-cloud-client-id
# TINA_TOKEN=your-tina-cloud-read-only-token
# TINA_BRANCH=main
