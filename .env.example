# ── Lead capture ───────────────────────────────────────────────────────────
# Every form posts to /api/lead, a fixed same-origin path. There is deliberately
# no endpoint URL to configure: the previous PUBLIC_LEAD_ENDPOINT design meant a
# URL you could leave unset, and that is exactly how this site launched with all
# five forms inert. What is configurable is DESTINATIONS, and `npm run
# leads:check` fails a production build when they are missing.
#
# The Google Sheet is the system of record; the email is a notification. A
# submission is never reported as successful unless it reached the sheet.

# The whole service-account JSON, base64-encoded:  base64 -i service-account.json
# Base64 because the private key is multi-line and raw newlines get mangled
# between a clipboard, a dashboard field and a shell — producing an opaque
# invalid_grant at runtime. One line has nothing to mangle.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# The spreadsheet ID, from its URL:
#   docs.google.com/spreadsheets/d/<THIS>/edit
# The sheet lives in the CLIENT's Google account and is shared with the service
# account as an Editor. It needs a tab named "Submissions".
LEAD_SHEET_ID=

# Resend API key. Sends from no-reply@thelinks.golf to the venue inbox, with
# Reply-To set to the submitter so replying reaches the customer.
RESEND_API_KEY=

# Any long random string. Signs the form's timestamp for the spam check.
LEAD_FORM_SECRET=

# ── TinaCMS ────────────────────────────────────────────────────────────────
# LOCAL MODE (default): leave these unset. `npm run dev` runs Tina against the
# local filesystem with no cloud account — edits write straight to src/content.
#
# TINA CLOUD (optional, for hosted multi-user editing): create a project at
# https://app.tina.io, then set:
# TINA_CLIENT_ID=your-tina-cloud-client-id
# TINA_TOKEN=your-tina-cloud-read-only-token
# TINA_BRANCH=main

# Set to "true" on the Vercel PREVIEW/staging environment. Makes every page emit
# <meta name="robots" content="noindex"> and serves a Disallow-all robots.txt.
# Must be unset (or "false") in production.
PUBLIC_SITE_NOINDEX=true
